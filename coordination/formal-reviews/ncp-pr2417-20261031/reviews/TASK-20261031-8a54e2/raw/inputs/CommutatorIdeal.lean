/-
Source: research/THM_COMMUTATOR_KERNEL1.md, Proposition 1.
Target: formal/targets/ncp-commutator-ideal-refutation.yaml.

The free associative Z-algebra has one generator for each translation and
one for negation. `affineGroup` is the subgroup of permutations of ZMod n
generated by every translation and negation, so its monoid algebra is the
group algebra Z[Aff(G)] used in the source claim. `evalRho` sends each free
generator to the corresponding group-algebra basis element.

The witness v² - 1 is in the evaluation kernel because negation is an
involution. It is outside the two-sided ideal generated by ALL algebra
commutators: the augmentation sending every free generator to zero maps
every commutator to zero but maps v² - 1 to -1. This proves the refutation
uniformly in the chosen translations, including cases where evaluation is
surjective. Surjectivity for any particular generating family is not needed
for the inequality and is not asserted here.
-/
import Mathlib.Algebra.FreeAlgebra
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.GroupTheory.Perm.Basic
import Mathlib.Data.ZMod.Basic

namespace CryptoResearch.NCP

abbrev NCAlgebra (B : Nat) := FreeAlgebra ℤ (Sum (Fin B) Unit)

def negGenerator (B : Nat) : NCAlgebra B :=
  FreeAlgebra.ι ℤ (Sum.inr ())

def transGenerator (B : Nat) (i : Fin B) : NCAlgebra B :=
  FreeAlgebra.ι ℤ (Sum.inl i)

def commutatorSet (B : Nat) : Set (NCAlgebra B) :=
  {z | ∃ x y : NCAlgebra B, z = x * y - y * x}

def commutatorIdeal (B : Nat) : TwoSidedIdeal (NCAlgebra B) :=
  TwoSidedIdeal.span (commutatorSet B)

private def augmentation (B : Nat) : NCAlgebra B →ₐ[ℤ] ℤ :=
  FreeAlgebra.lift ℤ (fun _ => 0)

private theorem commutatorIdeal_le_augmentation_ker (B : Nat) :
    commutatorIdeal B ≤ TwoSidedIdeal.ker (augmentation B) := by
  apply (TwoSidedIdeal.span_le).2
  rintro z ⟨x, y, rfl⟩
  apply (TwoSidedIdeal.mem_ker (augmentation B)).2
  simp [mul_comm]

/-- The torsion witness survives the commutative quotient. The augmentation
to Z is enough to distinguish it, without constructing a polynomial ring. -/
theorem neg_square_sub_one_not_mem_commutatorIdeal (B : Nat) :
    (negGenerator B) ^ 2 - 1 ∉ commutatorIdeal B := by
  intro h
  have hker : (negGenerator B) ^ 2 - 1 ∈ TwoSidedIdeal.ker (augmentation B) :=
    commutatorIdeal_le_augmentation_ker B h
  have hz := (TwoSidedIdeal.mem_ker (augmentation B)).mp hker
  simp [augmentation, negGenerator] at hz

/-- All translations and negation acting on the underlying additive group. -/
def affineGenerators (G : Type*) [AddGroup G] : Set (Equiv.Perm G) :=
  Set.range (fun g : G => (Equiv.addRight g : Equiv.Perm G)) ∪
    {Equiv.neg G}

/-- The affine permutation group generated by translations and negation. -/
def affineGroup (G : Type*) [AddGroup G] : Subgroup (Equiv.Perm G) :=
  Subgroup.closure (affineGenerators G)

def translationElement {G : Type*} [AddGroup G] (g : G) : affineGroup G :=
  ⟨Equiv.addRight g, Subgroup.subset_closure (Or.inl ⟨g, rfl⟩)⟩

def negElement (G : Type*) [AddGroup G] : affineGroup G :=
  ⟨Equiv.neg G, Subgroup.subset_closure (Or.inr (by simp))⟩

private theorem negElement_sq (G : Type*) [AddGroup G] :
    (negElement G) ^ 2 = 1 := by
  apply Subtype.ext
  apply Equiv.ext
  intro x
  change -(-x) = x
  exact neg_neg x

/-- Evaluation of the free algebra in the group algebra of the affine group.
`ZMod n` uses `1` as the distinguished cyclic generator; `s i` is the
translation scalar or, equivalently, `s_i • 1`. -/
noncomputable def evalRho (B n : Nat) (s : Fin B → ZMod n) :
    NCAlgebra B →ₐ[ℤ] MonoidAlgebra ℤ (affineGroup (ZMod n)) :=
  FreeAlgebra.lift ℤ (fun z =>
    match z with
    | .inl i => MonoidAlgebra.of ℤ (affineGroup (ZMod n))
        (translationElement (s i))
    | .inr _ => MonoidAlgebra.of ℤ (affineGroup (ZMod n))
        (negElement (ZMod n)))

theorem evalRho_trans (B n : Nat) (s : Fin B → ZMod n) (i : Fin B) :
    evalRho B n s (transGenerator B i) =
      MonoidAlgebra.of ℤ (affineGroup (ZMod n)) (translationElement (s i)) := by
  simp [evalRho, transGenerator]

theorem evalRho_neg (B n : Nat) (s : Fin B → ZMod n) :
    evalRho B n s (negGenerator B) =
      MonoidAlgebra.of ℤ (affineGroup (ZMod n)) (negElement (ZMod n)) := by
  simp [evalRho, negGenerator]

/-- Negation has order two in the affine permutation group. -/
theorem neg_witness_mem_evalRho_ker (B n : Nat) (s : Fin B → ZMod n) :
    (negGenerator B) ^ 2 - 1 ∈ TwoSidedIdeal.ker (evalRho B n s) := by
  apply (TwoSidedIdeal.mem_ker (evalRho B n s)).2
  change evalRho B n s ((negGenerator B) ^ 2 - 1) = 0
  rw [map_sub, map_pow, map_one]
  rw [evalRho_neg]
  rw [← map_pow (MonoidAlgebra.of ℤ (affineGroup (ZMod n)))
    (negElement (ZMod n)) 2, negElement_sq, map_one]
  simp

/-- Negation torsion lies in the evaluation kernel but survives every
commutator quotient, so the kernel cannot equal the commutator ideal. The
statement holds for every factor-base size, modulus and translation list;
in particular it applies whenever that list makes the evaluation onto. -/
theorem kernel_not_generated_by_commutators (B n : Nat)
    (s : Fin B → ZMod n) :
    TwoSidedIdeal.ker (evalRho B n s) ≠ commutatorIdeal B := by
  intro heq
  have hker := neg_witness_mem_evalRho_ker B n s
  rw [heq] at hker
  exact neg_square_sub_one_not_mem_commutatorIdeal B hker

end CryptoResearch.NCP
