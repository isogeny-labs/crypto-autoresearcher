ubscribers_url":"https://api.github.com/repos/isogeny-labs/crypto/subscribers","subscription_url":"https://api.github.com/repos/isogeny-labs/crypto/subscription","tags_url":"https://api.github.com/repos/isogeny-labs/crypto/tags","teams_url":"https://api.github.com/repos/isogeny-labs/crypto/teams","trees_url":"https://api.github.com/repos/isogeny-labs/crypto/git/trees{/sha}"},"score":1.0,"text_matches":[{"object_url":"https://api.github.com/repositories/1221029056/contents/research/ic_mega_pass_20261031/brief/MAP_ideas_corpus.json?ref=12a2b3d85f1796a9e793b7206763691e994012cd","object_type":"FileContent","property":"content","fragment":"  {\n   \"name\": \"THM_QUOTIENT_DESCENT1 Only 2-torsion translations descend through a degree-2 quotient of E\",\n   \"statement\": \"PROVED (elementary, Lean-formalised as translation_commutes_iff_two_torsion): for iota_S(P)=-(P+S), any S in E(k), translation tau_T descends through the degree-2 quotient E/<iota_S> -> P^1 iff 2T=O. Corollary: the translation group acting on solutions of any x-type summation polynomial is E[2](k)^m cap {sum T_i=O}, so the full symmetry group from translations and permutations is a subgroup of E[2]^{m-1} x| S_m of order <= 4^{m-1} m!. Closes Galbraith's 'larger group actions?' question for every x-type coordinate (corrected 2026-10-16 to all S, not only 2-torsion S).\",","matches":[{"text":"THM_QUOTIENT_DESCENT1","indices":[16,37]}]},{"object_url":"https://api.github.com/repositories/1221029056/contents/research/ic_mega_pass_20261031/brief/MAP_ideas_corpus.json?ref=12a2b3d85f1796a9e793b7206763691e994012cd","object_type":"FileContent","property":"content","fragment":"   \"scope_limits\": \"Covers degree-2 (x-type) quotients of E. Does not cover: higher-degree quotient maps E -> P^1 (e.g. degree-3 or degree-N quotients where larger translation groups could descend, Kummer-line-of-degree-d), quotients to other curves, or symmetries that are not translations (Frobenius, CM automorphisms).\",\n   \"source\": \"/Volumes/SSD990-2/crypto-autoresearcher/research/THM_QUOTIENT_DESCENT1.md\"\n  },","matches":[{"text":"THM_QUOTIENT_DESCENT1","indices":[387,408]}]}]}]}