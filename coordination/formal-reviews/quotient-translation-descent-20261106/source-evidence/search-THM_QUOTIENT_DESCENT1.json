3d85f1796a9e793b7206763691e994012cd","object_type":"FileContent","property":"content","fragment":"    \"Covers degree-2 (x-type) quotients of E. Does not cover: higher-degree quotient maps E -> P^1 (e.g. degree-3 or degree-N quotients where larger translation groups could descend, Kummer-line-of-degree-d), quotients to other curves, or symmetries that are not translations (Frobenius, CM automorphisms).\",\n    f\"{THM}/THM_QUOTIENT_DESCENT1.md\")\n","matches":[{"text":"THM_QUOTIENT_DESCENT1","indices":[321,342]}]}]},{"name":"MP-symmetry-2.refute.json","path":"research/ic_mega_pass_20261031/verdicts/MP-symmetry-2.refute.json","sha":"c34872e766eb858adfb9840e91aa0c476f240963","url":"https://api.github.com/repositories/1221029056/contents/research/ic_mega_pass_20261031/verdicts/MP-symmetry-2.refute.json?ref=12a2b3d85f1796a9e793b7206763691e994012cd","git_url":"https://api.github.com/repositories/1221029056/git/blobs/c34872e766eb858adfb9840e91aa0c476f240963","html_url":"https://github.com/isogeny-labs/crypto/blob/12a2b3d85f1796a9e793b7206763691e994012cd/research/ic_mega_pass_20261031/verdicts/MP-symmetry-2.refute.json","repository":{"id":1221029056,"node_id":"MDEwOlJlcG9zaXRvcnkxMjIxMDI5MDU2","name":"crypto","full_name":"isogeny-labs/crypto","owner":{"id":347052081,"node_id":"O_kgDOFK-YMQ","login":"isogeny-labs","avatar_url":"https://avatars.githubusercontent.com/u/347052081?v=4","gravatar_id":"","url":"https://api.github.com/users/isogeny-labs","html_url":"https://github.com/isogeny-labs","type":"Organization","site_admin":false,"followers_url":"https://api.github.com/users/isogeny-labs/followers","following_url":"https://api.github.com/users/isogeny-labs/following{/other_user}","gists_url":"https://api.github.com/users/isogeny-labs/gists{/gist_id}","starred_url":"https://api.github.com/users/isogeny-labs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isogeny-labs/subscriptions","organizations_url":"https://api.github.com/users/isogeny-labs/org