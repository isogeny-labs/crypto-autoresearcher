                (sub_self.{u} (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} 0 T) S)))))
            (Eq.refl.{u + 1} 0))),
    mpr := fun hT P =>
      have key := translation_commutes_iff_two_torsion._abel_1_2.{u} S T P;
      Eq.mpr.{0}
        (id.{0}
          (congrArg.{u + 1, 1} (fun _a => Eq.{u + 1} _a (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} P T) S)))
            key))
        (Eq.mpr.{0}
          (id.{0}
            (congrArg.{u + 1, 1}
              (fun _a =>
                Eq.{u + 1} (HAdd.hAdd.{u, u, u} (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} P T) S)) _a)
                  (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} P T) S)))
              hT))
          (Eq.mpr.{0}
            (id.{0}
