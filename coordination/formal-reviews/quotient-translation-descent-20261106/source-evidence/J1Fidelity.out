theorem CryptoResearch.Quotient.translation_commutes_iff_two_torsion.{u} : ∀ {E : Type u} [inst : AddCommGroup.{u} E]
  (S T : E),
  (∀ (P : E),
      Eq.{u + 1} (HAdd.hAdd.{u, u, u} (Neg.neg.{u} (HAdd.hAdd.{u, u, u} P S)) T)
