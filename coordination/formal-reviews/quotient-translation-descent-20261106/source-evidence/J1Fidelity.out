                (fun _a => Eq.{u + 1} _a (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} P T) S)))
                (add_zero.{u} (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} P T) S)))))
            (Eq.refl.{u + 1} (Neg.neg.{u} (HAdd.hAdd.{u, u, u} (HAdd.hAdd.{u, u, u} P T) S))))) }
