def CryptoResearch.Nagao.RecoveryRule.IsFall.{u_1, u_2, u_3} : {σ : Type u_1} →
  {R : Type u_2} →
    [inst : CommRing R] → {ι : Type u_3} → [Fintype ι] → (ι → MvPolynomial σ R) → (ι → MvPolynomial σ R) → ℕ → Prop :=
fun {σ} {R} [CommRing R] {ι} [Fintype ι] fs g D =>
  (∀ (i : ι), (g i * fs i).totalDegree ≤ D) ∧
    (∃ i, (g i * fs i).totalDegree = D) ∧ ∑ i, g i * fs i ≠ 0 ∧ (∑ i, g i * fs i).totalDegree < D
def CryptoResearch.Nagao.RecoveryRule.IsFakeFall.{u_1, u_2, u_3} : {σ : Type u_1} →
  {R : Type u_2} →
    [inst : CommRing R] → {ι : Type u_3} → [Fintype ι] → (ι → MvPolynomial σ R) → (ι → MvPolynomial σ R) → ℕ → Prop :=
fun {σ} {R} [CommRing R] {ι} [Fintype ι] fs g D =>
  (∀ (i : ι), (RecoveryRule.red (g i * fs i)).totalDegree ≤ D) ∧
    (∃ i, (RecoveryRule.red (g i * fs i)).totalDegree = D) ∧
      RecoveryRule.red (∑ i, g i * fs i) ≠ 0 ∧ (RecoveryRule.red (∑ i, g i * fs i)).totalDegree < D
def CryptoResearch.Nagao.RecoveryRule.withFe.{u_1, u_2, u_3} : {σ : Type u_1} →
  {R : Type u_2} → [inst : CommRing R] → {ι : Type u_3} → (ι → MvPolynomial σ R) → ι ⊕ σ → MvPolynomial σ R :=
fun {σ} {R} [CommRing R] {ι} fs => Sum.elim fs RecoveryRule.fe
def CryptoResearch.Nagao.RecoveryRule.red.{u_1, u_2} : {σ : Type u_1} →
  {R : Type u_2} → [inst : CommRing R] → MvPolynomial σ R → MvPolynomial σ R :=
fun {σ} {R} [CommRing R] p => ∑ a ∈ p.support, (MvPolynomial.monomial (RecoveryRule.clamp a)) (p.coeff a)
def CryptoResearch.Nagao.RecoveryRule.clamp.{u_1} : {σ : Type u_1} → (σ →₀ ℕ) → σ →₀ ℕ :=
fun {σ} a => Finsupp.mapRange (fun n => min n 1) RecoveryRule.clamp._proof_1 a
def CryptoResearch.Nagao.RecoveryRule.fe.{u_1, u_2} : {σ : Type u_1} →
  {R : Type u_2} → [inst : CommRing R] → σ → MvPolynomial σ R :=
fun {σ} {R} [CommRing R] j => MvPolynomial.X j ^ 2 - MvPolynomial.X j
def CryptoResearch.Nagao.RecoveryRule.deg.{u_1} : {σ : Type u_1} → [Fintype σ] → (σ →₀ ℕ) → ℕ :=
fun {σ} [Fintype σ] a => ∑ i, a i
def CryptoResearch.Nagao.Bridge.FirstFallIs.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → Bridge.P) → ℕ → Prop :=
fun {ι} [Fintype ι] fs d =>
  (∃ G, RecoveryRule.IsFall fs G d) ∧ ∀ (D : ℕ), 1 ≤ D → D < d → ¬∃ G, RecoveryRule.IsFall fs G D
def CryptoResearch.Nagao.Bridge.Lemma4Mv.{u_1, u_2} : {ι : Type u_1} →
  {κ : Type u_2} → [Fintype ι] → [Fintype κ] → (ι → Bridge.P) → (κ → Bridge.P) → Prop :=
fun {ι} {κ} [Fintype ι] [Fintype κ] fsTrue fsFake =>
  ∀ (d : ℕ), Bridge.FirstFallIs fsTrue d → ∀ (D : ℕ), (∃ g, RecoveryRule.IsFakeFall fsFake g D) → d ≤ D
def CryptoResearch.Nagao.BridgeB.FirstFallIs'.{u_1, u_2} : {σ : Type u_1} →
  {ι : Type u_2} → [DecidableEq σ] → [Fintype σ] → [Fintype ι] → (ι → MvPolynomial σ (ZMod 2)) → ℕ → Prop :=
fun {σ} {ι} [DecidableEq σ] [Fintype σ] [Fintype ι] fs d =>
  (∃ G, RecoveryRule.IsFall fs G d) ∧ ∀ (D : ℕ), 1 ≤ D → D < d → ¬∃ G, RecoveryRule.IsFall fs G D
def CryptoResearch.Nagao.BridgeB.Lemma4Mv'.{u_1, u_2, u_3} : {σ : Type u_1} →
  {ι : Type u_2} →
    {κ : Type u_3} →
      [DecidableEq σ] →
        [Fintype σ] →
          [Fintype ι] → [Fintype κ] → (ι → MvPolynomial σ (ZMod 2)) → (κ → MvPolynomial σ (ZMod 2)) → Prop :=
fun {σ} {ι} {κ} [DecidableEq σ] [Fintype σ] [Fintype ι] [Fintype κ] fsTrue fsFake =>
  ∀ (d : ℕ), BridgeB.FirstFallIs' fsTrue d → ∀ (D : ℕ), (∃ g, RecoveryRule.IsFakeFall fsFake g D) → d ≤ D
def CryptoResearch.Nagao.Bridge.toMv : (n : ℕ) → Lemma4Witness.Poly → MvPolynomial (Fin n) (ZMod 2) :=
fun n p => (List.map (fun m => (MvPolynomial.monomial (Bridge.expOf n m)) 1) p).sum
def CryptoResearch.Nagao.Bridge.expOf : (n : ℕ) → List ℕ → Fin n →₀ ℕ :=
fun n m => Finsupp.equivFunOnFinite.symm fun i => m.getD (↑i) 0
def CryptoResearch.Nagao.Bridge.mA₁ : Bridge.P :=
MvPolynomial.X 0 ^ 2 * MvPolynomial.X 1
def CryptoResearch.Nagao.Bridge.mA₂ : Bridge.P :=
MvPolynomial.X 0 * MvPolynomial.X 1 + MvPolynomial.X 0
def CryptoResearch.Nagao.Bridge.mFA : Fin 2 → Bridge.P :=
![Bridge.mA₁, Bridge.mA₂]
def CryptoResearch.Nagao.Bridge.Gout : Fin 2 → Bridge.P :=
![1, MvPolynomial.X 0]
def CryptoResearch.Nagao.Bridge.Gin : Fin 2 ⊕ Fin 2 → Bridge.P :=
Sum.elim Bridge.Gout 0
def CryptoResearch.Nagao.Bridge.gFake : Fin 2 → Bridge.P :=
![1, 1]
def CryptoResearch.Nagao.BridgeB.mB₁ : BridgeB.Q :=
MvPolynomial.X 0 * MvPolynomial.X 1 + MvPolynomial.X 2
def CryptoResearch.Nagao.BridgeB.mB₂ : BridgeB.Q :=
MvPolynomial.X 0 * MvPolynomial.X 2 + MvPolynomial.X 1
def CryptoResearch.Nagao.BridgeB.mFB : Fin 2 → BridgeB.Q :=
![BridgeB.mB₁, BridgeB.mB₂]
def CryptoResearch.Nagao.BridgeB.GoutB : Fin 2 → BridgeB.Q :=
![MvPolynomial.X 2, MvPolynomial.X 1]
def CryptoResearch.Nagao.BridgeB.GinB : Fin 2 ⊕ Fin 3 → BridgeB.Q :=
Sum.elim BridgeB.GoutB 0
def CryptoResearch.Nagao.BridgeB.gFakeB : Fin 2 → BridgeB.Q :=
![1, MvPolynomial.X 0 + 1]
def CryptoResearch.Nagao.Lemma4Witness.FirstFall : ℕ → Bool → List Lemma4Witness.Poly → ℕ → Prop :=
fun n fake S D => Lemma4Witness.FallAt n fake S D ∧ ∀ (D' : ℕ), 1 ≤ D' → D' < D → ¬Lemma4Witness.FallAt n fake S D'
def CryptoResearch.Nagao.Lemma4Witness.FallAt : ℕ → Bool → List Lemma4Witness.Poly → ℕ → Prop :=
fun n fake S D =>
  ∃ gs,
    List.Forall₂ (Lemma4Witness.Adm n D fake) gs (Lemma4Witness.gens fake S) ∧
      Lemma4Witness.Cond fake D gs (Lemma4Witness.gens fake S)
def CryptoResearch.Nagao.Lemma4Witness.Cond : Bool → ℕ → List Lemma4Witness.Poly → List Lemma4Witness.Poly → Prop :=
fun fake D gs S =>
  have P := List.zipWith (fun g s => Lemma4Witness.prep fake (Lemma4Witness.mul g s)) gs S;
  have total := Lemma4Witness.prep fake (Lemma4Witness.norm P.flatten);
  (∀ p ∈ P, Lemma4Witness.DegLe p D) ∧ (∃ p ∈ P, ∃ m ∈ p, List.sum m = D) ∧ total ≠ [] ∧ ∀ m ∈ total, List.sum m < D
def CryptoResearch.Nagao.Lemma4Witness.Adm : ℕ → ℕ → Bool → Lemma4Witness.Poly → Lemma4Witness.Poly → Prop :=
fun n D fake g s =>
  List.Sublist g (Lemma4Witness.mons n D fake) ∧ Lemma4Witness.DegLe (Lemma4Witness.prep fake (Lemma4Witness.mul g s)) D
def CryptoResearch.Nagao.Lemma4Witness.gens : Bool → List Lemma4Witness.Poly → List Lemma4Witness.Poly :=
fun fake S => if fake = true then List.filter (fun x => decide (x ≠ [])) (List.map Lemma4Witness.reduceFe S) else S
def CryptoResearch.Nagao.Lemma4Witness.prep : Bool → Lemma4Witness.Poly → Lemma4Witness.Poly :=
fun fake p => if fake = true then Lemma4Witness.reduceFe p else p
def CryptoResearch.Nagao.Lemma4Witness.reduceFe : Lemma4Witness.Poly → Lemma4Witness.Poly :=
fun p => Lemma4Witness.norm (List.map (fun m => List.map (min 1) m) p)
def CryptoResearch.Nagao.Lemma4Witness.mul : Lemma4Witness.Poly → Lemma4Witness.Poly → Lemma4Witness.Poly :=
fun p q => Lemma4Witness.norm (List.flatMap (fun a => List.map (Lemma4Witness.monoMul a) q) p)
def CryptoResearch.Nagao.Lemma4Witness.monoMul : Lemma4Witness.Mono → Lemma4Witness.Mono → Lemma4Witness.Mono :=
fun a b => List.zipWith (fun x1 x2 => x1 + x2) a b
def CryptoResearch.Nagao.Lemma4Witness.norm : List Lemma4Witness.Mono → Lemma4Witness.Poly :=
fun l => (List.filter (fun m => List.count m l % 2 == 1) l).dedup
def CryptoResearch.Nagao.Lemma4Witness.mons : ℕ → ℕ → Bool → List Lemma4Witness.Mono :=
fun n D fake => Lemma4Witness.monsAux n (if fake = true then 1 else D) D
def CryptoResearch.Nagao.Lemma4Witness.monsAux : ℕ → ℕ → ℕ → List Lemma4Witness.Mono :=
fun x x_1 x_2 => Nat.brecOn (motive := fun x => ℕ → ℕ → List Lemma4Witness.Mono) x Lemma4Witness.monsAux._f x_1 x_2
def CryptoResearch.Nagao.Lemma4Witness.DegLe : Lemma4Witness.Poly → ℕ → Prop :=
fun p D => ∀ m ∈ p, List.sum m ≤ D
def CryptoResearch.Nagao.Lemma4Witness.fieldEqs : ℕ → List Lemma4Witness.Poly :=
fun n =>
  List.map
    (fun i =>
      [List.map (fun j => if j = i then 2 else 0) (List.range n),
        List.map (fun j => if j = i then 1 else 0) (List.range n)])
    (List.range n)
def CryptoResearch.Nagao.Lemma4Witness.Lemma4Inside : ℕ → List Lemma4Witness.Poly → Prop :=
fun n S => ∀ (d d' : ℕ), Lemma4Witness.FirstFall n false S d → Lemma4Witness.FirstFall n true S d' → d ≤ d'
def CryptoResearch.Nagao.Lemma4Outside.Lemma4Outside : ℕ → List Lemma4Witness.Poly → Prop :=
fun n F => ∀ (d d' : ℕ), Lemma4Witness.FirstFall n false F d → Lemma4Witness.FirstFall n true F d' → d ≤ d'
def CryptoResearch.Nagao.Lemma4Outside.Lemma4OutsideFe : ℕ → List Lemma4Witness.Poly → Prop :=
fun n F =>
  ∀ (d d' : ℕ),
    Lemma4Witness.FirstFall n false F d → Lemma4Witness.FirstFall n true (F ++ Lemma4Witness.fieldEqs n) d' → d ≤ d'
def CryptoResearch.Nagao.Lemma4Witness.SA : List Lemma4Witness.Poly :=
[Lemma4Witness.fA₁, Lemma4Witness.fA₂] ++ Lemma4Witness.fieldEqs 2
def CryptoResearch.Nagao.Lemma4Witness.SB : List Lemma4Witness.Poly :=
[Lemma4Witness.fB₁, Lemma4Witness.fB₂] ++ Lemma4Witness.fieldEqs 3
