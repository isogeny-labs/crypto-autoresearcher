{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-prime101-default A/A fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture", "trace", "prover", "checker", "certificate", "classification", "labels", "runtime"],
  "properties": {
    "fixture": {"type": "object", "additionalProperties": false, "required": ["id", "public_input"], "properties": {"id": {"const": "public-prime101-default"}, "public_input": {"const": "101\n"}}},
    "trace": {"type": "object"}, "prover": {"type": "object"}, "checker": {"type": "object"},
    "certificate": {"type": "object", "required": ["sha256", "root", "step_count"]},
    "classification": {"const": "CONTROL_VALID"}, "labels": {"const": ["prime"]}, "runtime": {"type": "object"}
  }
}
