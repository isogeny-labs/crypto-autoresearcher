{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-prime101 build_pair result",
  "type": "object",
  "additionalProperties": false,
  "required": ["validity", "aa", "left", "right", "raw_custody"],
  "properties": {
    "validity": {"const": "CONTROL_VALID"},
    "aa": {"type": "object", "additionalProperties": false, "required": ["mode", "equal", "scope"], "properties": {"mode": {"const": "A/A"}, "equal": {"const": true}, "scope": {"type": "string"}}},
    "left": {"$ref": "#/$defs/document"},
    "right": {"$ref": "#/$defs/document"},
    "raw_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/custody"},
        "right": {"$ref": "#/$defs/custody"}
      }
    }
  },
  "$defs": {
    "custody": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "trace", "prover", "checker", "certificate", "classification", "labels", "runtime"],
      "properties": {
        "fixture": {"type": "object", "additionalProperties": false, "required": ["id", "public_input"], "properties": {"id": {"const": "public-prime101-default"}, "public_input": {"const": "101\n"}}},
        "trace": {"type": "object", "additionalProperties": false, "required": ["prover_events", "checker_events"], "properties": {"prover_events": {"$ref": "#/$defs/events"}, "checker_events": {"$ref": "#/$defs/events"}}},
        "prover": {"$ref": "#/$defs/status"},
        "checker": {"$ref": "#/$defs/status"},
        "certificate": {"type": "object", "additionalProperties": false, "required": ["root", "steps", "bytes_sha256"], "properties": {"root": {"const": 101}, "steps": {"type": "array", "minItems": 1}, "bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "classification": {"const": "PRIOR_PRIMALITY_EVIDENCE_REQUIRED"},
        "labels": {"const": ["prime"]},
        "runtime": {"type": "object", "additionalProperties": false, "required": ["binding_manifest_sha256", "primary_configuration", "limits"], "properties": {"binding_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "primary_configuration": {"const": {"argv": ["/program", "-l", "/ecpp/", "-f", "/input", "-Fc", "-C", "/tmp/certificate"], "checker_argv": ["/program", "-f", "/input"], "full_original_catalog": true, "original_factor_parameters": true, "proving": true, "n_minus_1": true, "n_plus_1": true, "distributed": false, "debug": false, "fresh_process_rng": "original ModInitialize: srandom(1)", "fresh_vm_per_control": true}}, "limits": {"const": {"emulated_cpus": 1, "vm_ram_mib": 256, "child_address_space_mib": 128, "prover_guest_seconds": 300, "prover_host_seconds": 390, "checker_guest_seconds": 30, "checker_host_seconds": 90}}}}
      }
    },
    "events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["raw_hex"], "properties": {"raw_hex": {"type": "string", "pattern": "^[0-9a-f]*$"}}}},
    "status": {"type": "object", "additionalProperties": false, "required": ["qemu_exit", "child_exit", "reason", "elapsed_host_seconds"], "properties": {"qemu_exit": {"const": 33}, "child_exit": {"const": 0}, "reason": {"type": "null"}, "elapsed_host_seconds": {"type": "number", "minimum": 0}}}
  }
}
