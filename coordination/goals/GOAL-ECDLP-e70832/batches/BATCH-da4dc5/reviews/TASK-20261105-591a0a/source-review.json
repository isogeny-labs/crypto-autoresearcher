  "causal_quiet_argument": [
    {
      "source": "driver.py:159-218",
      "text": "Driver observe/release precedes baseline execution. Its arm loop polls for process exit or resource stop. CUSTODY.closed occurs after proc.wait and source/process record write. During the confirmed stopped interval (<200s), no completion/closure occurs; no resource stop was recorded. [pcc:unverified]"
    },
    {
      "source": "driver.py:234-275",
      "text": "execute is sequential candidate then baseline; CUSTODY.finish follows execute return. A still-stopped unfinished baseline prevents that path. [pcc:unverified]"
    },
    {
      "source": "observer.py:61-99,144-189",
      "text": "Absolute framed-message deadline; active outstanding arm chooses quiet_timeout=seconds+grace+5=207. Observer remains alive during the independently observed hold. Quiet>120 is a source-supported causal lower bound; no internal observer monotonic interval is measured. [pcc:unverified]"
    },
    {
      "source": "helper.py",
      "text": "Only /proc reads, file reads/writes, ordinary timing, STOP/CONT and native Popen/wait are used; helper sends no observer IPC. [pcc:unverified]"
    }
  ],
