{
  "$defs": {
    "capsule_member": {
      "additionalProperties": false,
      "properties": {
        "base64": {
          "type": "string"
        },
        "length": {
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "type": {
          "const": "regular"
        }
      },
      "required": [
        "name",
        "type",
        "length",
        "sha256",
        "base64"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "nist.fixed-x.native/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attack_claimed": {
      "const": false
    },
    "checker_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "driver_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "experiment_id": {
      "type": "string"
    },
    "native_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "propertyNames": {
        "enum": [
          "driver.stdout.txt",
          "driver.stderr.txt",
          "driver-exit.json",
          "fixed-x.raw.json.gz"
        ]
      },
      "type": "object"
    },
    "packaging_completed": {
      "type": "boolean"
    },
    "packaging_error": {
      "type": [
        "object",
        "null"
      ]
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_path": {
      "type": "string"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "const": "nist.fixed-x.native/v2"
    },
    "semantic_error": {
      "type": [
        "object",
        "null"
      ]
    },
    "summary": {
      "type": [
        "object",
        "null"
      ]
    },
    "valid": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "attack_claimed",
    "experiment_id",
    "run_id",
    "plan_sha256",
    "protocol_path",
    "protocol_file_sha256",
    "protocol_sha256",
    "checker_sha256",
    "valid",
    "summary",
    "packaging_completed",
    "packaging_error",
    "semantic_error",
    "native_artifacts",
    "driver_manifest_sha256"
  ],
  "title": "Fixed-x native raw custody record",
  "type": "object",
  "x-count-domains": {
    "canonical_omission_lifts": "The eleven canonical omission rows only; only this domain enters the canonical zero-lift criterion.",
    "lift_count": "Each complete arm's arithmetic rows; 24 in main and A/A.",
    "main_lift_count": "The complete main arm's 24 representation rows."
  },
  "x-semantic-authority": "native_bridge_v2.verify validates retained semantics; schema conformance alone establishes no observation validity.",
  "x-supervisor-generated": [
    "launch.json",
    "execution-receipt.json",
    "command.txt",
    "environment.json",
    "stdout.log",
    "stderr.log",
    "check.stdout.log",
    "check.stderr.log"
  ],
  "x-top-level-trial-artifacts": [
    "manifest.yaml",
    "raw-result.json",
    "driver-exit.json",
    "driver.stdout.txt",
    "driver.stderr.txt",
    "fixed-x.raw.json.gz"
  ]
}
