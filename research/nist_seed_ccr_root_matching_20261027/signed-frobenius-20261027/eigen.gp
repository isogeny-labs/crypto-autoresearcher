setrand(1);
\\ Independent finite-field eigenvalue orders; formal scalar maps, no reduced-polynomial derivative.
scal(p,A,B,n,l)={my(E=ellinit([Mod(A,p),Mod(B,p)]),x='x,f=Mod(1,p)*(x^3+A*x+B),P=elldivpol(E,l),k=lift(Mod(p+1-n,l)/2),dn,pr,N,X,Y);if(k==1,return(Mod(x,P)^p==Mod(x,P) && Mod(f,P)^((p-1)/2)==1));dn=elldivpol(E,k)^2;pr=elldivpol(E,k-1)*elldivpol(E,k+1);if(k%2,pr=pr/(4*f),dn=dn/(4*f));N=x*dn-pr;X=Mod(N,P)/Mod(dn,P);Y=Mod(deriv(N)*dn-N*deriv(dn),P)/(k*Mod(dn,P)^2);X==Mod(x,P)^p && Y==Mod(f,P)^((p-1)/2)};
co(p,t,l,ev,kind,proj)={my(ds=List(),v=vector(4,j,List()),known,cand,ord,a,lambda,tr,ii);if(kind==0||kind==1,return(vector(8,j,1)));if(kind==3,return(vector(8)));for(d=2,l-1,if((l-1)%d==0 && ((kronecker(p,l)==1)==(((l-1)/d*(d-1))%2==0)),listput(ds,d)));for(j=1,#ev,lambda=ev[j];tr=min(lambda,l-lambda);for(kk=1,2,known=kk==1;cand=List();for(a=1,(l-1)/2,ord=znorder(Mod(a^2,l)/Mod(p,l));if((if(known,ord==proj,setsearch(Set(ds),ord))) && (l%4==3 || kronecker(a,l)==kronecker(lambda,l)),listput(cand,a)));ii=if(known,1,3);listput(v[ii],#cand);listput(v[ii+1],setsearch(Set(cand),tr));if(!setsearch(Set(cand),tr),error("true eigenvalue excluded"))));concat(vector(4,j,[vecmin(Vec(v[j])),vecmax(Vec(v[j]))]))};
one(p,A,B,n,l,control=0)={my(t=p+1-n,dp=t^2-4*p,ev=vecsort(apply(lift,Vec(polrootsmod('z^2-t*'z+p,l)))),kind,ss=0,fo,xo,po,al,be,d,da,db,xa,xb,pat=Map(),tmp,cost);if(dp%l==0,if(dp%(l^2)==0||control,ss=scal(p,A,B,n,l));kind=if(ss,0,1);al=lift(Mod(t,l)/2);fo=znorder(Mod(al,l))*if(ss,1,l);xo=if(znorder(Mod(al,l))%2==0,fo/2,fo);po=if(ss,1,l);da=znorder(Mod(al,l));xa=if(da%2==0,da/2,da);mapput(pat,xa,(l-1)/(2*xa));if(!ss,mapput(pat,l*xa,l*(l-1)/(2*l*xa)),mapput(pat,xa,(l^2-1)/(2*xa))),if(#ev,kind=2;ev=apply(lift,ev);al=ev[1];be=ev[2];da=znorder(Mod(al,l));db=znorder(Mod(be,l));fo=lcm(da,db);xo=fo;if(fo%2==0 && Mod(al,l)^(fo/2)==-1 && Mod(be,l)^(fo/2)==-1,xo=fo/2);po=znorder(Mod(al,l)/Mod(be,l));xa=if(da%2==0,da/2,da);xb=if(db%2==0,db/2,db);for(j=1,3,d=if(j==1,xa,if(j==2,xb,xo));tmp=if(j<3,(l-1)/2,(l-1)^2/2);mapput(pat,d,if(mapisdefined(pat,d),mapget(pat,d),0)+tmp/d)),kind=3;al=ffgen(Mod(1,l)*('z^2-t*'z+p));fo=fforder(al);xo=if(fo%2==0,fo/2,fo);po=fforder(al^(l-1));mapput(pat,xo,(l^2-1)/(2*xo))));cost=co(p,t,l,ev,kind,po);[kind,fo,xo,po,Mat(pat),apply(lift,ev),cost,ss]};
