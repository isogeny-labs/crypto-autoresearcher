===== E1/E2/E1-R: ecbench workflow, scope rule, audit script, audit.rs
#
# PRs validate every historical session hash/seal/answer without rerunning
# expensive historical solvers. Fresh smoke sessions replay eight runs.
# The weekly/manual lane retains exhaustive all-run replay and historical
# independent-receipt/claim reconstruction. PR correctness receipts
# are CI diagnostics, never full independent-replay certificates for claims.
#
# Every committed ecbench session is found by its schema, not by where it
# lives: a directory whose session.json has schema `ecbench.session/v1`,
# wherever it is in the tree (sheriff case SHF-20261016-3caa6f, E2: 167
# sessions outside research/ecbench_*/sessions/ were never re-verified).
# Each complete or interrupted session is integrity-audited (hashes, seals,
# plan, answers, derived figures, grading; --replay 0) on ecbench pull
# requests and in the weekly/manual lane, and is evidence that is never
# edited. Four scratch sessions lacking spec/host capsules are hash-pinned in
# docs/ecbench/INCOMPLETE_SESSIONS.tsv and reported separately. An interrupted session,
# including one whose runner was killed before it could mark it (still
# `running`), is accepted by --allow-interrupted as evidence of the
# interruption: every per-record check still applies.
#
on:
  pull_request:
    branches: [main]
    types: [opened, synchronize, reopened, ready_for_review]
  merge_group:
  push:
    branches: [main]
  workflow_dispatch:
-- schedule/cron triggers in ecbench.yml:
0
      - name: Check out and list every committed ecbench session
        run: |
          list="$RUNNER_TEMP/ecbench-sessions.txt"
          mapfile -t candidates < <(git ls-tree -r --name-only HEAD | sed -n 's#/session\.json$##p')
          test "${#candidates[@]}" -gt 0 || { echo '::error::no session.json in the tree'; exit 1; }
          printf '/%s/\n' "${candidates[@]}" | git sparse-checkout add --stdin
          : > "$list"
          for d in "${candidates[@]}"; do
            test -f "$d/session.json" || { echo "::error::$d/session.json was not checked out"; exit 1; }
            if jq -e '.schema == "ecbench.session/v1"' "$d/session.json" > /dev/null; then
              echo "$d" >> "$list"
            fi
          done
          test -s "$list" || { echo '::error::no committed ecbench sessions found'; exit 1; }
          echo "$(wc -l < "$list") committed ecbench sessions (by schema)" | tee -a "$GITHUB_STEP_SUMMARY"
