digraph chronology {
  graph [rankdir=LR, bgcolor="white", pad="0.15", nodesep="0.25", ranksep="0.35", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#eff5f8", fontname="Helvetica", fontsize=11, margin="0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#52687a"];
  curve [label="Final published curve
coefficient b"];
  xs [label="Fixed FreeLIP stream
x1, x2, ..."];
  test [label="Replay membership
on final curve"];
  point [label="Six exact
published Gx matches", fillcolor="#d9eee8"];
  caller [label="Original caller order,
curve/point pairing, retry rule", style="rounded,dashed", fillcolor="white"];
  curve -> test; xs -> test; test -> point;
  caller -> test [style=dashed, label="unknown"];
}
