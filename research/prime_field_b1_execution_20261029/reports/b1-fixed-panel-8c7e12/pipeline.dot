digraph archive {
      rankdir=LR; ranksep=0.18; nodesep=0.15; graph [bgcolor="transparent",fontname="Helvetica"];
      node [shape=box,style="rounded,filled",fillcolor="#edf3f8",fontname="Helvetica",fontsize=10];
      inputs [label="Frozen inputs
16 atoms; 64 sources"];
      collect [label="Full collection
two arms"];
      replay [label="Separate replay
complete stream"];
      analysis [label="Old-kernel test
new equations"];
      database [label="SQLite archive
source hashes"];
      functions [label="Cubic groups
cache unmeasured"];
      shifted [label="Shifted algebra
survey unrun",fillcolor="#fff1d9"];
      inputs -> collect -> replay -> analysis -> database -> functions;
      analysis -> shifted [style=dashed,label="proposed",fontsize=9];
    }
