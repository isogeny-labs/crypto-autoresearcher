ck(x)={if(!x,error("assertion failed"))};
mhit(p,r)={my(v=1);if(p==r,return(-1));for(k=1,100,v=(v*p)%r;if(v==1,return(k)));0};
nextpoint(E,p,x)={my(ys,y);while(x<=255,ys=ellordinate(E,x);if(#ys,y=lift(ys[1]);y=min(y,p-y);return([x,y]));x++);error("point cap")};
cert(E,p,N,F)={my(L=p+1-sqrtint(4*p),H=p+1+sqrtint(4*p),M=1,W=List(),x=0,P,o,q);for(z=1,8,P=nextpoint(E,p,x);x=P[1]+1;if(ellmul(E,P,N)!=[0],return([N,M,Vec(W),0]));o=N;for(i=1,#F,q=F[i][1];for(j=1,F[i][2],if(ellmul(E,P,o/q)==[0],o/=q,break)));listput(W,[P[1],P[2],o]);M=lcm(M,o);if((H\M)-((L+M-1)\M)+1==1 && ((L+M-1)\M)*M==N,return([N,M,Vec(W),1])));[N,M,Vec(W),0]};
EC=ellinit([Mod(-3,101),Mod(6,101)]);ck(isprime(109));ck(cert(EC,101,109,[[109,1]])[4]);ck(cert(EC,101,107,[[107,1]])[4]==0);ck(!ellisoncurve(EC,[0,0]));ck((4*(-3)^3+27*2^2)%101==0);ck(mhit(2,7)==3);ck(mhit(3,7)==6);ck(101==101);print("CONTROLS PASS");
seen=Set([]);
for(idx=1,#rows,my(r=rows[idx],i=r[1],p=r[2],b=r[3],n=r[4],c=r[5],F=r[6],Ntw=2*p+2-n,prod=1,q,d=2,E,Em,Et,C0,Cm,Ct,Nm,Fm,rootmatch=-1,km,kt,qmax=0,np=isprime(n),ns=((4*(-3)^3+27*b^2)%p!=0),cr=((c*b^2+27)%p==0));ck(isprime(p));ck(ns);for(j=1,#F,q=F[j][1];ck(F[j][2]>0);if(!setsearch(seen,q),ck(isprime(q));seen=setunion(seen,[q]));prod*=q^F[j][2];qmax=max(qmax,q));ck(prod==Ntw);E=ellinit([Mod(-3,p),Mod(b,p)]);C0=if(np,cert(E,p,n,[[n,1]]),[n,1,[],0]);Nm=if(p%4==1,n,Ntw);Fm=if(p%4==1,[[n,1]],F);Em=ellinit([Mod(-3,p),Mod(-b,p)]);Cm=cert(Em,p,Nm,Fm);while(kronecker(d,p)!=-1,d++);Et=ellinit([Mod(-3*d^2,p),Mod(b*d^3,p)]);Ct=cert(Et,p,Ntw,F);if(p%4==3,rootmatch=(b==lift(Mod(b^2,p)^((p+1)/4))));km=mhit(p,n);kt=mhit(p,qmax);print([i,C0,b<p-b,b%2==0,rootmatch,Nm,isprime(Nm),Cm,d,Ntw,isprime(Ntw),Ct,qmax,#binary(qmax),km,kt,n==p,Ntw==p,#binary(n)<=#binary(p),np,ns,cr,1]));
print("COMPLETE");quit;
