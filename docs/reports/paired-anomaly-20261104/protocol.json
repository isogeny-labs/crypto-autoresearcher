      "id": "C1",
      "text": "REPLICATED iff Mann-Whitney p < 0.01 with mean u(D) < mean u(E); NOT_REPLICATED iff p >= 0.05.",
      "class": "comparative",
      "decided_by": [
        "C-weak-vs-ordinary"
      ],
      "if_supported": "a procedural bias exists in the pairing selection; hunt its mechanism with the recorded features before any weak-class cell is read",
      "if_not_supported": "the paired-curve anomaly was chance; the weak-class pairing baseline stands"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
