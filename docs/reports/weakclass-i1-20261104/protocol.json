   "decided_by": [
    "C-weak-vs-ordinary"
   ],
   "if_supported": "cell table and overdispersion verdict are recorded on the weak-class row; OVERDISPERSED means I1 nulls from negation-closed random sets are too narrow for small-x log sets at n <= 2^14",
   "if_not_supported": "n/a: descriptive per cell"
  }
 ],
