digraph BINSTDCanonicalFrobenius {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.42, ranksep=0.52, pad=0.2];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.11"];
  edge [arrowsize=0.7, penwidth=1.3];
  source [label="Frozen n=17 factor bitmasks\n3, 313, 471", fillcolor="#eef2f9", color="#4b6584"];
  factor [label="Source-bound Lean product\nfactor1 · factor8a · factor8b = X¹⁷+1", fillcolor="#eaf4ee", color="#297148"];
  field [label="Mathlib canonical GF(2¹⁷)\nextension degree 17", fillcolor="#eaf4ee", color="#297148"];
  frob [label="Frobenius x -> x²\norder 17; minimal polynomial X¹⁷+1", fillcolor="#eaf4ee", color="#297148"];
  result [label="Lean conjunction\nminimal polynomial = archived factor product", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  gap [label="Still open: bind runner's t¹⁷+t³+1 field\nand classify all invariant subspaces", style="rounded,dashed,filled", fillcolor="#fff6e5", color="#b87823"];
  yield [label="Toy relation yield remains empirical", style="rounded,dashed,filled", fillcolor="#f2f3f7", color="#6d7280"];
  source -> factor -> result;
  field -> frob -> result;
  result -> gap -> yield;
}
