digraph Plan {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=0.38, fontname="DejaVu Sans", label="Classical-only ECDLP: exact output and the missing computation", labelloc=t, fontsize=15];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.11", fillcolor="#eef2f6", color="#5b6878"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#5b6878"];
  input [label="Public E, P, r, Q\nClassical single-target ECDLP"];
  circuit [label="CLASSICAL BOOLEAN PROGRAM\nDeterministic bit operations on CPU/GPU\ncanonical scalar and unique internal wires", fillcolor="#e4f1fb", color="#3979a6"];
  count [label="CLASSICAL EXACT COUNTING\nTarget-conditioned XOR and bit-vector tags\nconstant bit + all scalar-bit coefficients", fillcolor="#e4f1fb", color="#3979a6"];
  slow [label="KNOWN FALLBACK\nEnumerate r inputs\nCorrect, but slower than rho", fillcolor="#f5e7e7", color="#ae6c6c"];
  missing [label="RESEARCH DEBT: NOT CONSTRUCTED\nEC-specific block cancellation identity\nPreserve every tag; compose cheaply", fillcolor="#fff0cb", color="#bb861b", style="rounded,filled,dashed"];
  costs [label="PENDING CHECKS\nCharge construction + contraction + recovery\nexact controls, blind targets, memory", fillcolor="#f2edf9", color="#8971aa"];
  novelty [label="PENDING NOVELTY TEST\nDistinct from existing classical counting,\narray elimination and ladder quotients", fillcolor="#f2edf9", color="#8971aa"];
  result [label="CONDITIONAL FUTURE OUTPUT\nVerified k and a scoped cost statement\nNo current speedup or exponent claim", fillcolor="#edf2ed", color="#718e72"];
  input -> circuit -> count;
  count -> slow [label="explicit summation"];
  count -> missing [label="investigate", style=dashed];
  missing -> novelty [style=dashed];
  novelty -> costs [style=dashed];
  costs -> result [style=dashed];
}
