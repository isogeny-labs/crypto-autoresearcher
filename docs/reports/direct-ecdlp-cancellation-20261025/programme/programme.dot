digraph programme {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.4", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#245889", fontname="DejaVu Sans", fontsize=11, margin="0.13"];
  edge [color="#526372", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  scope [label="Classical ECDLP: direct response + nine named lead families\nCPU/GPU; no factor-base pipeline; no quantum"];
  cards [label="Per-lead contracts\nQuestion / object / controls / metrics / outcomes"];
  controls [label="Known controls and scoped obstructions\nRespect hypotheses; preserve failed candidates"];
  checks [label="Development checks completed\n3 tiny curves; 13,731 reference assertions\nPoint states only; no speed measurement"];
  missing [label="Missing constructions\nTotal bit circuit + exact rewrite / locator / decoder\nPublic constructor and composition argument", style="rounded,dashed,filled", fillcolor="#fff3d6", color="#ad7010"];
  finite [label="Future admitted finite discovery\nFrozen grammar; exact tagged boundaries\nCounterexamples retained", style="rounded,dashed,filled", fillcolor="#fff3d6", color="#ad7010"];
  confirm [label="Future frozen confirmation\n24 fresh curves; 192 random targets\nSeparate correctness edges; cluster by curve", style="rounded,dashed,filled", fillcolor="#fff3d6", color="#ad7010"];
  claim [label="Later claim assessment\nFull costs + matched baselines + independent reconstruction\nNovelty and asymptotics remain unverified", style="rounded,dashed,filled", fillcolor="#fff3d6", color="#ad7010"];
  scope -> cards;
  cards -> controls;
  cards -> missing;
  controls -> checks;
  checks -> finite [style=dashed,label="instrument qualification only"];
  missing -> finite [style=dashed,label="requires implementation + admission"];
  finite -> confirm [style=dashed,label="freeze surviving construction"];
  confirm -> claim [style=dashed];
}
