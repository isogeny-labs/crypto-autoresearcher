digraph BINSTDIrreducibility {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.45, ranksep=0.55, pad=0.2];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.11"];
  edge [arrowsize=0.7, penwidth=1.3];
  frozen [label="Frozen n=17 factors\nbitmasks 313 and 471\nexact constants bound in parent theorem", fillcolor="#eef2f9", color="#4b6584"];
  product [label="Lean product theorem\n(X+1) · factor8a · factor8b = X¹⁷+1", fillcolor="#eaf4ee", color="#297148"];
  cyclo [label="Cyclotomic bridge\nfactor8a · factor8b = Φ₁₇ over F₂", fillcolor="#eaf4ee", color="#297148"];
  order [label="Lean finite calculation\norder of 2 mod 17 = 8\nboth factors have degree 8", fillcolor="#eaf4ee", color="#297148"];
  result [label="Mathlib cyclotomic criterion\nboth degree-8 factors irreducible", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  gap [label="Still open: archived field Frobenius\nnormal-basis module and exhaustive\ninvariant-subspace dimensions", style="rounded,dashed,filled", fillcolor="#fff6e5", color="#b87823"];
  yield [label="Toy relation yield remains empirical\nno performance or security theorem", style="rounded,dashed,filled", fillcolor="#f2f3f7", color="#6d7280"];
  frozen -> product -> cyclo -> order -> result -> gap -> yield;
}
