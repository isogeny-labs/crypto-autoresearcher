{
  "mcpServers": {
    "ecdb": {
      "type": "http",
      "url": "https://l6zg6lz4dr45t75p5qn5aocnme0pckrm.lambda-url.us-west-2.on.aws/mcp",
      "headers": {
        "Authorization": "Bearer ${ECDB_TOKEN:-}"
      }
    },
    "crypto-kb": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "kb",
        "--extra",
        "index",
        "--extra",
        "mcp",
        "python",
        "-m",
        "crypto_kb.mcp.server"
      ],
      "env": {
        "CRYPTO_KB_CLIENT": "claude-code"
      }
    },
    "cairn-lab": {
      "command": "sh",
      "args": [
        "tools/lab_mcp.sh"
      ]
    },
    "cairn": {
      "command": "sh",
      "args": [
        "tools/cairn_mcp.sh"
      ]
    }
  }
}
