{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment observation presentation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "crypto.autoresearch.experiment_observation.v1"
    },
    "report_kind": {
      "enum": [
        "run_observations",
        "reanalysis",
        "progress_snapshot"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "object"
        },
        "seeds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling_unit": {
          "type": "string",
          "minLength": 1
        },
        "stopping_rule": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "description",
        "command",
        "parameters",
        "seeds",
        "sampling_unit",
        "stopping_rule"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "native_status": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          }
        },
        "required": [
          "experiment_id",
          "run_id",
          "native_status",
          "evidence"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/local_id"
            }
          },
          "matching": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "description",
          "observation_ids",
          "matching",
          "limitations"
        ]
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "kind": {
            "enum": [
              "observed_deviation",
              "exploratory_pattern",
              "suspected_measurement_artifact"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/local_id"
            }
          },
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/local_id"
            }
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          },
          "alternative_explanations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "observation_ids",
          "reference_ids",
          "uncertainty",
          "alternative_explanations"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^/"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "reason"
        ]
      }
    },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "proposed"
          }
        },
        "required": [
          "question",
          "method",
          "control",
          "status"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "commit",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema",
    "report_kind",
    "question",
    "scope",
    "method",
    "runs",
    "observations",
    "controls",
    "patterns",
    "limitations",
    "missing",
    "next_checks",
    "artifacts"
  ],
  "$defs": {
    "local_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/local_id"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact",
        "selector"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "measured",
            "derived"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "sample": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "n": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "dependence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "n",
                "unit",
                "dependence"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "description",
        "kind",
        "value",
        "unit",
        "sample",
        "uncertainty",
        "evidence"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "patterns": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "next_checks": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
