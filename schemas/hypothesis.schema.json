{
  "type": "object",
  "required": ["hypothesis"],
  "additionalProperties": false,
  "properties": {
    "hypothesis": {
      "type": "object",
      "required": ["id", "question_id", "statement", "mechanism", "assumptions", "predictions", "test_boundary", "falsification_conditions", "interpretation_limits", "status", "proposed_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "H-[A-Z0-9-]+-[0-9]{3,}"},
        "question_id": {"type": "string", "pattern": "RQ-[A-Z0-9-]+-[0-9]{3,}"},
        "statement": {"type": "string"},
        "mechanism": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric", "direction", "minimum_effect"],
            "additionalProperties": false,
            "properties": {
              "metric": {"type": "string"},
              "direction": {"type": "string", "enum": ["higher", "lower", "different"]},
              "minimum_effect": {"type": ["string", "number"]}
            }
          }
        },
        "test_boundary": {
          "type": "object",
          "required": ["instances", "parameters", "implementation", "budget"],
          "additionalProperties": false,
          "properties": {
            "instances": {"type": "array", "items": {"type": "string"}},
            "parameters": {"type": "object"},
            "implementation": {"type": "string"},
            "budget": {"type": "object"}
          }
        },
        "falsification_conditions": {"type": "array", "items": {"type": "string"}},
        "interpretation_limits": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["proposed", "specified", "approved", "running", "analyzed", "replicated", "supported", "weakened", "rejected", "inconclusive", "superseded", "rejected_scoped"]},
        "proposed_by": {"type": "string"}
      }
    }
  }
}
