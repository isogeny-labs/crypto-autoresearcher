{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isogeny-labs/crypto-autoresearcher/blob/main/schemas/prime-field-ecdlp-family.v1.json",
  "title": "Prime-field ECDLP asymptotic family definition",
  "description": "A planning and experiment-input schema. Conformance checks metadata completeness; it is not a hardness certificate, point-count certificate, primality proof, or scientific status record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "family_id",
    "revision",
    "status",
    "question",
    "asymptotic_scale",
    "quantifier",
    "sampler",
    "admission",
    "exception_controls",
    "algorithm_model",
    "cost_accounting",
    "success_criterion",
    "claim_boundary"
  ],
  "properties": {
    "format": {
      "const": "prime-field-ecdlp-family/v1"
    },
    "family_id": {
      "type": "string",
      "pattern": "^PFSE-FAMILY-[A-Z0-9-]+-V[0-9]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "retired"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "algorithm_class",
        "time_target",
        "memory_target",
        "quantum_excluded"
      ],
      "properties": {
        "problem": {
          "const": "ECDLP"
        },
        "algorithm_class": {
          "const": "uniform classical randomized"
        },
        "time_target": {
          "const": "2^o(n) total expected bit operations"
        },
        "memory_target": {
          "const": "2^o(n) peak bits"
        },
        "quantum_excluded": {
          "const": true
        }
      }
    },
    "asymptotic_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_definition",
        "r_role",
        "p_relation",
        "subexponential_definition"
      ],
      "properties": {
        "n_definition": {
          "const": "n = ceil(log2(r))"
        },
        "r_role": {
          "const": "prime order of the declared target subgroup"
        },
        "p_relation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "enforcement"
          ],
          "properties": {
            "statement": {
              "const": "log2(p) = Theta(n)"
            },
            "enforcement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "subexponential_definition": {
          "const": "lim_{n->infinity} log2(T(n))/n = 0"
        }
      }
    },
    "quantifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "curve_measure",
        "target_measure",
        "algorithm_randomness",
        "probability_order"
      ],
      "properties": {
        "kind": {
          "enum": [
            "worst_case",
            "average_case",
            "density_one"
          ]
        },
        "curve_measure": {
          "type": "string",
          "minLength": 1
        },
        "target_measure": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_randomness": {
          "type": "string",
          "minLength": 1
        },
        "probability_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "curve_sampler",
              "generator_sampler",
              "target_scalar_sampler",
              "algorithm_coins"
            ]
          }
        }
      }
    },
    "sampler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_space",
        "deterministic_from_seed",
        "prime_sampling",
        "coefficient_sampling",
        "point_count",
        "subgroup_selection",
        "generator_sampling",
        "target_sampling",
        "rejection_rules",
        "failure_semantics"
      ],
      "properties": {
        "seed_space": {
          "type": "string",
          "minLength": 1
        },
        "deterministic_from_seed": {
          "const": true
        },
        "prime_sampling": {
          "$ref": "#/$defs/algorithm_step"
        },
        "coefficient_sampling": {
          "$ref": "#/$defs/algorithm_step"
        },
        "point_count": {
          "$ref": "#/$defs/certified_step"
        },
        "subgroup_selection": {
          "$ref": "#/$defs/certified_step"
        },
        "generator_sampling": {
          "$ref": "#/$defs/algorithm_step"
        },
        "target_sampling": {
          "$ref": "#/$defs/algorithm_step"
        },
        "rejection_rules": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/rejection_rule"
          }
        },
        "failure_semantics": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_degree",
        "minimum_characteristic",
        "curve_model",
        "nonsingular",
        "ordinary",
        "subgroup_order_prime",
        "cofactor_policy",
        "p_bit_length",
        "r_bit_length",
        "excluded_j_invariants",
        "embedding_degree_guard",
        "required_certificate_fields"
      ],
      "properties": {
        "field_degree": {
          "const": 1
        },
        "minimum_characteristic": {
          "type": "integer",
          "minimum": 5
        },
        "curve_model": {
          "const": "short_weierstrass_y2=x3+ax+b"
        },
        "nonsingular": {
          "const": true
        },
        "ordinary": {
          "const": true
        },
        "subgroup_order_prime": {
          "const": true
        },
        "cofactor_policy": {
          "type": "string",
          "minLength": 1
        },
        "p_bit_length": {
          "type": "string",
          "minLength": 1
        },
        "r_bit_length": {
          "type": "string",
          "minLength": 1
        },
        "excluded_j_invariants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "embedding_degree_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k_definition",
            "threshold",
            "admission_test",
            "interpretation"
          ],
          "properties": {
            "k_definition": {
              "const": "k = multiplicative_order_mod_r(p)"
            },
            "threshold": {
              "type": "string",
              "minLength": 1
            },
            "admission_test": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_certificate_fields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exception_controls": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "algorithm_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uniform",
        "public_input",
        "preprocessing_dependencies",
        "preprocessing_charged",
        "advice",
        "single_target_primary",
        "multi_target_separate",
        "operation_cost_model"
      ],
      "properties": {
        "uniform": {
          "const": true
        },
        "public_input": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preprocessing_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "family",
              "curve",
              "subgroup",
              "generator",
              "target"
            ]
          }
        },
        "preprocessing_charged": {
          "const": true
        },
        "advice": {
          "const": "no nonuniform advice"
        },
        "single_target_primary": {
          "const": true
        },
        "multi_target_separate": {
          "const": true
        },
        "operation_cost_model": {
          "const": "probabilistic multi-tape Turing machine bit operations, with field/group/oracle counts retained as secondary units"
        }
      }
    },
    "cost_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_unit",
        "phases",
        "parallelism",
        "success_repetitions",
        "failed_attempts",
        "memory",
        "stored_data",
        "communication"
      ],
      "properties": {
        "primary_unit": {
          "const": "bit operations"
        },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instance_generation",
            "setup",
            "preprocessing",
            "transfer_construction",
            "transfer_evaluation",
            "relation_collection",
            "relation_verification",
            "solver",
            "rank_updates",
            "linear_algebra",
            "target_descent",
            "recovery",
            "final_verification"
          ],
          "properties": {
            "instance_generation": {"const": true},
            "setup": {"const": true},
            "preprocessing": {"const": true},
            "transfer_construction": {"const": true},
            "transfer_evaluation": {"const": true},
            "relation_collection": {"const": true},
            "relation_verification": {"const": true},
            "solver": {"const": true},
            "rank_updates": {"const": true},
            "linear_algebra": {"const": true},
            "target_descent": {"const": true},
            "recovery": {"const": true},
            "final_verification": {"const": true}
          }
        },
        "parallelism": {
          "const": "processors and total work both reported"
        },
        "success_repetitions": {
          "const": "charged to reach declared success probability"
        },
        "failed_attempts": {
          "const": "retained and charged"
        },
        "memory": {
          "const": "peak live bits and allocation boundary reported"
        },
        "stored_data": {
          "const": "persistent advice/tables in bits reported separately"
        },
        "communication": {
          "const": "messages and transmitted bits reported for parallel/distributed algorithms"
        }
      }
    },
    "success_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability_at_least",
        "correctness_check",
        "detectable_failure",
        "expected_time_condition"
      ],
      "properties": {
        "probability_at_least": {
          "const": "2/3"
        },
        "correctness_check": {
          "const": "verify Q = [s]P in the declared subgroup"
        },
        "detectable_failure": {
          "type": "boolean"
        },
        "expected_time_condition": {
          "const": "expectation uses the probability order declared by quantifier.probability_order"
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_conformance_means",
        "schema_conformance_does_not_mean",
        "experiment_limit",
        "nonexistence_limit"
      ],
      "properties": {
        "schema_conformance_means": {
          "const": "required family, quantifier, model, cost, and control metadata are present"
        },
        "schema_conformance_does_not_mean": {
          "const": "the curve arithmetic, certificates, sampler distribution, hardness, or asymptotic claim is mathematically verified"
        },
        "experiment_limit": {
          "const": "finite experiments can falsify named instruments, heuristics, cost models, or architectures only"
        },
        "nonexistence_limit": {
          "const": "nonexistence requires a proof covering the explicitly stated computation model and family quantifiers"
        }
      }
    }
  },
  "$defs": {
    "algorithm_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "distribution"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "certified_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "certificate",
        "independent_verification"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "certificate": {
          "type": "string",
          "minLength": 1
        },
        "independent_verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rejection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "predicate",
        "reason",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "exclude_and_keep_as_control",
            "reject_invalid",
            "reject_out_of_family"
          ]
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "expected_classification",
        "purpose",
        "fixture_binding",
        "verification_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CTRL-[A-Z0-9-]+$"
        },
        "kind": {
          "enum": [
            "anomalous",
            "supersingular",
            "small_embedding_degree",
            "smooth_group_order",
            "structured_endomorphism",
            "ordinary_admitted",
            "metadata_mutation"
          ]
        },
        "expected_classification": {
          "enum": [
            "included",
            "excluded",
            "invalid"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "fixture_binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_state": {
          "enum": [
            "missing",
            "generated",
            "independently_verified"
          ]
        }
      }
    }
  }
}
