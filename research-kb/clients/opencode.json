{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "research-kb": {
      "type": "local",
      "enabled": true,
      "command": [
        "/absolute/path/to/research-kb",
        "mcp"
      ],
      "environment": {
        "RESEARCH_KB_HOME": "/absolute/shared/research-kb-data",
        "RESEARCH_KB_CONFIG": "/absolute/path/to/sources.toml"
      }
    }
  }
}
