  "n_curves_per_size": 10,
  "curve_rule": "p = nextprime(2^bits + sha256(master|bits|slot|'p') mod 2^(bits-6)); attempts t=1,2,... with a,b from sha256; ACCEPT iff #E is prime (cofactor 1) and j unseen in this size class; rejected slots are recorded, never re-tuned; #E certified by BSGS+lcm order in the Hasse window and then by an independent naive O(p) point count. Acceptance depends only on #E's factorisation and j novelty, never on any rate statistic.",
  "arms": {
    "N3": "floor(p^(1/3))",
    "N2": "floor(sqrt(p))"
  },
  "m_values": [
    3,
    4
  ],
  "n_targets_per_cell": 1000,
  "n_null_draws": 50,
  "null_kinds": {
    "uniform": "b distinct uniform points of G",
    "symmetric": "b/2 distinct uniform points of G together with their negatives (uniform over negation-closed b-subsets; b even)"
  },
  "primary_null": "symmetric",
  "primary_null_reason": "B_G is PROVABLY negation-closed: the x-window contains both y-signs, so B_raw = -B_raw; multiplication by the cofactor is a homomorphism, so B_G = -B_G; O is removed, so |B_G| is even. A uniform set is not negation-closed, and for m=4 the m-fold sumset of a symmetric set factors as (B+B)+(B+B) -- a squared measure with strictly larger count variance, hence lower coverage at equal tuple supply. The uniform null is therefore confounded with a provable structural difference that is not the property under test. Verdicts use the symmetric null; the uniform null is reported as the pilot-comparable secondary.",
  "secondary_null": "uniform",
  "target_rule": "targets for a curve: 1000 points g^k with k uniform on [1,n) from Random(sha256(master|bits|slot|'targets')); the same target multiset is used for every arm, every m and every null draw of that curve (paired comparison)",
  "statistic": "r = #targets admitting >=1 ordered m-tuple from B summing to the target, divided by n_targets; ordered (repetitions allowed)",
  "per_curve_z": "(r_x - mean_j r_j) / sd_j, sd_j = sample sd (ddof=1) over 50 draws",
  "cell_z": "mean_c(z_c) / (sd_c(z_c)/sqrt(10)) over the 10 curves; two-sided p from Student t with 9 df",
  "sign_consistency": "#curves with r_x > mean_j r_j, out of 10",
  "testability_rule": "cell is TESTABLE iff predicted coverage 1-exp(-b^m/(m! n)) <= 0.995 for every curve in the cell (computed at freeze time from b, m, n only)",
  "decision_rule": "REPLICATED iff, in the Holm-corrected family of designed cells (all 8; saturated cells score p=1 and cannot pass), >= 2 cells have |cell_z| >= 2.5 AND are Holm-significant at family alpha=0.05 AND each has sign consistency >= 7/10. Otherwise NOT REPLICATED at this power, and the achieved MDE is reported. Secondary (pilot-comparable) verdict uses the uniform null; disagreements are reported explicitly.",
  "family": "all 8 designed (bits x arm x m) cells",
  "alpha": 0.05,
  "holm": true,
  "min_abs_cell_z": 2.5,
  "min_sign_consistency": 7,
  "mde_rule": "per-cell MDE in per-curve null-sd units at 80% power, family alpha=0.05 with Holm over 8 cells: (z_{1-alpha/16} + z_{0.8})/sqrt(10) = (2.734+0.842)/3.1623 = 1.13 per-curve sigma; reported in fraction units as 1.13 * mean_c(sd_null_c) / sqrt(10)... i.e. 1.13*sigma_per_curve/sqrt(10) is the MDE on the CELL MEAN of r",
  "design_note": "the N2 arm is predicted saturated at both sizes by the dimension count (lam_ordered = b^m/n = 2.6e2 .. 3.6e2 for m=3), so the informative family is the 4 N3 cells; this is a design computation from b, m, n, not a result",
