{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classical.ecdlp.endpoint-reuse.public-verification.case.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture", "replicate", "target_id", "target_ordinal", "arm", "producer_status", "producer_upstream_status", "public_witness_verified", "trace_integrity", "retained_terminal_equations", "lookup_ranges_checked", "lookup_witnesses_checked", "promotions_checked", "insertions_committed", "endpoint_known_after", "endpoint_pending_peak", "endpoint_capacity"],
  "properties": {
    "fixture": {"type": "string", "minLength": 1},
    "replicate": {"type": "integer", "minimum": 0},
    "target_id": {"type": "string", "minLength": 1},
    "target_ordinal": {"type": "integer", "minimum": 0},
    "arm": {"enum": ["static_full", "static_filled", "static_small", "harvest", "harvest_disabled", "rho_reference"]},
    "producer_status": {"enum": ["solved", "failed", "censored", "invalid"]},
    "producer_upstream_status": {"type": "integer", "minimum": 0, "maximum": 7},
    "public_witness_verified": {"type": "boolean"},
    "trace_integrity": {"const": "pass"},
    "retained_terminal_equations": {"type": "integer", "minimum": 0},
    "lookup_ranges_checked": {"type": "integer", "minimum": 0},
    "lookup_witnesses_checked": {"type": "integer", "minimum": 0},
    "promotions_checked": {"type": "integer", "minimum": 0},
    "insertions_committed": {"type": "integer", "minimum": 0},
    "endpoint_known_after": {"type": "integer", "minimum": 0},
    "endpoint_pending_peak": {"type": "integer", "minimum": 0},
    "endpoint_capacity": {"type": "integer", "minimum": 0}
  }
}
