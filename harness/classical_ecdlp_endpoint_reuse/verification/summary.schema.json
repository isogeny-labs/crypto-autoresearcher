{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classical.ecdlp.endpoint-reuse.public-verification.v1",
  "type": "object",
  "required": ["schema", "status", "input_sha256", "verifier_sha256", "hidden_scalar_labels_read", "scientific_review_or_performance_qualification"],
  "properties": {
    "schema": {"const": "classical.ecdlp.endpoint-reuse.public-verification.v1"},
    "status": {"enum": ["public_equations_and_trace_pass", "invalid_public_record"]},
    "input_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "verifier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hidden_scalar_labels_read": {"const": false},
    "scientific_review_or_performance_qualification": {"const": false},
    "raw_rows": {"type": "integer", "minimum": 0},
    "public_fixtures": {"type": "integer", "minimum": 1},
    "public_target_ids": {"type": "integer", "minimum": 1},
    "target_arm_cases": {"type": "integer", "minimum": 1},
    "expected_arms": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"enum": ["static_full", "static_filled", "static_small", "harvest", "harvest_disabled", "rho_reference"]}},
    "settings_cells": {"type": ["integer", "null"], "minimum": 1},
    "producer_cells": {"type": "integer", "minimum": 1},
    "verified_case_witnesses": {"type": "integer", "minimum": 0},
    "producer_status_counts": {"type": "object", "required": ["solved", "failed", "censored", "invalid"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "retained_terminal_equations": {"type": "integer", "minimum": 0},
    "promotions_checked": {"type": "integer", "minimum": 0},
    "arithmetic": {"const": "independently_coded_python_Jacobian"},
    "total_curve_order_independently_counted": {"const": false},
    "native_cost_counters_verified": {"const": false},
    "execution_or_isolation_attested": {"const": false},
    "table_state_hash64_is_cryptographic": {"const": false},
    "error": {"type": "string"},
    "location": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "public_equations_and_trace_pass"}}},
      "then": {"required": ["raw_rows", "public_fixtures", "public_target_ids", "target_arm_cases", "expected_arms", "settings_cells", "producer_cells", "verified_case_witnesses", "producer_status_counts", "retained_terminal_equations", "promotions_checked", "arithmetic", "total_curve_order_independently_counted", "native_cost_counters_verified", "execution_or_isolation_attested", "table_state_hash64_is_cryptographic"]},
      "else": {"required": ["error", "location"]}
    }
  ]
}
