@CryptoResearch.FallDegree.BinaryLocalization.localAffine_degree : ∀ {β : Type u_1} {τ : Type u_2} {k : Type u_3}
  [inst : Field k] [DecidableEq β] [DecidableEq τ] {A : Finset β} {p : MvPolynomial (β ⊕ τ) k},
  p ∈ CryptoResearch.FallDegree.BinaryLocalization.localAffine A → p.totalDegree ≤ A.card + 1
@CryptoResearch.FallDegree.BinaryLocalization.localAffine_normal_mul_base : ∀ {β : Type u_1} {τ : Type u_2}
  {k : Type u_3} [inst : Field k] [DecidableEq β] [DecidableEq τ] {A : Finset β} {p : MvPolynomial (β ⊕ τ) k},
  p ∈ CryptoResearch.FallDegree.BinaryLocalization.localAffine A →
    ∀ {i : β},
      i ∈ A →
        CryptoResearch.FallDegree.booleanNF (MvPolynomial.X (Sum.inl i) * p) ∈
          CryptoResearch.FallDegree.BinaryLocalization.localAffine A
@CryptoResearch.FallDegree.BinaryLocalization.staged_indicator_mem_V : ∀ {β : Type u_1} {τ : Type u_2} {k : Type u_3}
  [inst : Field k] [DecidableEq β] [DecidableEq τ] {F : Set (MvPolynomial (β ⊕ τ) k)} {D : ℕ} {A B : Finset β}
  {p : MvPolynomial (β ⊕ τ) k},
  p ∈ CryptoResearch.FallDegree.V (F ∪ CryptoResearch.FallDegree.fieldEqGens (β ⊕ τ) k 2) D →
    p ∈ CryptoResearch.FallDegree.BinaryLocalization.localAffine A →
      B ⊆ A →
        A.card + 2 ≤ D →
          ∀ (a : β → Bool),
            CryptoResearch.FallDegree.booleanNF (CryptoResearch.FallDegree.BinaryLocalization.indicator B a * p) ∈
                CryptoResearch.FallDegree.V (F ∪ CryptoResearch.FallDegree.fieldEqGens (β ⊕ τ) k 2) D ∧
              CryptoResearch.FallDegree.booleanNF (CryptoResearch.FallDegree.BinaryLocalization.indicator B a * p) ∈
                CryptoResearch.FallDegree.BinaryLocalization.localAffine A
@CryptoResearch.FallDegree.BinaryLocalization.indicator_interpolation : ∀ {β : Type u_1} {τ : Type u_2} {k : Type u_3}
  [inst : Field k] [DecidableEq β] [DecidableEq τ] {A : Finset β} {p : MvPolynomial (β ⊕ τ) k},
  p ∈ CryptoResearch.FallDegree.BinaryLocalization.localAffine A →
    ∀ (a : β → Bool),
      CryptoResearch.FallDegree.booleanNF (CryptoResearch.FallDegree.BinaryLocalization.indicator A a * p) =
        CryptoResearch.FallDegree.BinaryLocalization.indicator A a *
          (CryptoResearch.FallDegree.BinaryLocalization.specializeBase a) p
@CryptoResearch.FallDegree.BinaryLocalization.full_localized_row_mem_V : ∀ {β : Type u_1} {τ : Type u_2} {k : Type u_3}
  [inst : Field k] [DecidableEq β] [DecidableEq τ] {F : Set (MvPolynomial (β ⊕ τ) k)} {D : ℕ} {A B : Finset β}
  {p : MvPolynomial (β ⊕ τ) k},
  p ∈ CryptoResearch.FallDegree.V (F ∪ CryptoResearch.FallDegree.fieldEqGens (β ⊕ τ) k 2) D →
    p ∈ CryptoResearch.FallDegree.BinaryLocalization.localAffine A →
      A ⊆ B →
        A.card + 2 ≤ D →
          B.card + 1 ≤ D →
            ∀ (a : β → Bool),
              CryptoResearch.FallDegree.BinaryLocalization.indicator B a *
                  (CryptoResearch.FallDegree.BinaryLocalization.specializeBase a) p ∈
