@CryptoResearch.FallDegree.BinaryLocalization.specializeBase_affine : ∀ {β : Type u_1} {τ : Type u_2} {k : Type u_3}
  [inst : Field k] [DecidableEq β] [DecidableEq τ] [inst_3 : Fintype τ] {A : Finset β} {p : MvPolynomial (β ⊕ τ) k},
  p ∈ CryptoResearch.FallDegree.BinaryLocalization.localAffine A →
    ∀ (a : β → Bool),
      ∃ c v,
