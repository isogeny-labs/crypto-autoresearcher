@CryptoResearch.FallDegree.boolean_repair_mem_V : ∀ {σ : Type u_1} {k : Type u_2} [inst : Field k]
  (p : MvPolynomial σ k),
  p - CryptoResearch.FallDegree.booleanNF p ∈
    CryptoResearch.FallDegree.V (CryptoResearch.FallDegree.fieldEqGens σ k 2) p.totalDegree
@CryptoResearch.FallDegree.mem_V_iff_booleanNF_mem_V : ∀ {σ : Type u_1} {k : Type u_2} [inst : Field k]
  {F : Set (MvPolynomial σ k)} {p : MvPolynomial σ k} {D : ℕ},
  p.totalDegree ≤ D →
    (p ∈ CryptoResearch.FallDegree.V (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2) D ↔
      CryptoResearch.FallDegree.booleanNF p ∈
        CryptoResearch.FallDegree.V (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2) D)
@CryptoResearch.FallDegree.booleanNF_mem_V_of_mem_ideal_span : ∀ {σ : Type u_1} {k : Type u_2} [inst : Field k]
  [inst_1 : Fintype σ] {F : Set (MvPolynomial σ k)} {D : ℕ},
  Fintype.card σ + 1 ≤ D →
    (∀ f ∈ F, f.totalDegree ≤ D) →
      ∀ {p : MvPolynomial σ k},
        p ∈ Ideal.span (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2) →
          CryptoResearch.FallDegree.booleanNF p ∈
            CryptoResearch.FallDegree.V (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2) D
@CryptoResearch.FallDegree.lastFallSet_boolean_system : ∀ {σ : Type u_1} {k : Type u_2} [inst : Field k]
  [inst_1 : Fintype σ] {F : Set (MvPolynomial σ k)} {D : ℕ},
  Fintype.card σ + 1 ≤ D →
    (∀ f ∈ F, f.totalDegree ≤ D) →
      D ∈ CryptoResearch.FallDegree.lastFallSet (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2)
@CryptoResearch.FallDegree.lastFallDegree_boolean_system_le_max_card_degree : ∀ {σ : Type u_1} {k : Type u_2}
  [inst : Field k] [inst_1 : Fintype σ] {F : Set (MvPolynomial σ k)} {B : ℕ},
  (∀ f ∈ F, f.totalDegree ≤ B) →
    CryptoResearch.FallDegree.lastFallDegree (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2) ≤
      max (Fintype.card σ + 1) B
@CryptoResearch.FallDegree.lastFallDegree_multilinear_system_le_card_succ : ∀ {σ : Type u_1} {k : Type u_2}
  [inst : Field k] [inst_1 : Fintype σ] {F : Set (MvPolynomial σ k)},
  (∀ f ∈ F, ∀ (i : σ), MvPolynomial.degreeOf i f ≤ 1) →
    CryptoResearch.FallDegree.lastFallDegree (F ∪ CryptoResearch.FallDegree.fieldEqGens σ k 2) ≤ Fintype.card σ + 1
