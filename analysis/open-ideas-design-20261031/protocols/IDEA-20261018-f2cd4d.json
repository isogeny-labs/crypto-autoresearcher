  "question": "At (n,m,l)=(17,2,8),(19,2,9),(17,3,6),(19,3,6), is conflicts per distinct relation for Horner over plain+lex-SB in [0.8,1.25], while plain+SB is about 1/m! of plain?",
  "claims": [
    {
      "id": "C1",
      "text": "Distinct relations of plain (unordered) and Horner (ordered) are enumerated exactly per cell; MITM table sizes and probe counts come from the same enumeration.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "Horner costs the same per distinct relation as plain+SB, so the tau-Horner m! is the symmetry-breaking m! and the two do not compose.",
      "class": "comparative",
      "decided_by": [
        "C-sb"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "In the exhaustive-core regime the tau-Horner chain's per-relation m! is the same m! that lex symmetry breaking already removes.",
      "mechanism": "Plain+SB searches 2^(ml)/m! with B^m/(m! r) unordered solutions; Horner searches 2^(ml) with B^m/r ordered ones; both cost c 2^(ml) r/B^m per relation.",
      "predictions": [
        {
          "id": "P1",
          "metric": "horner_ratio",
          "direction": "equal_within",
          "minimum_effect": "0.8 to 1.25",
          "provenance": {
            "written_at": "2026-10-31",
            "data_seen": [],
            "sample_status": "out_of_sample"
          },
          "role": "decisive"
        },
        {
