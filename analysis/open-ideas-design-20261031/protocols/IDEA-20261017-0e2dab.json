  "question": "At n=40, k=20, does the sparse-f parity mixture give P=.316 (not .393) at 2000 z, with zero solutions whenever Tr(b/z)=1?",
  "claims": [
    {
      "id": "C1",
      "text": "N(z) is counted exactly for every z by exhaustive pushforward of V^2, split by Tr(b/z), and every table cell's instance band is recomputed from a(V).",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "Sparse-f P lies in [.30,.33] and differs from the dense-f .393 arm by more than the exact-count interval.",
      "class": "comparative",
      "decided_by": [
        "C-window"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "At |V|=2^20 the parity confinement makes the n=40 success probability .316 on sparse f, not .393.",
      "mechanism": "If f has second exponent s<=20 then Tr(alpha^j)=0 for j<n-s, so N(z)=0 for every z with Tr(b/z)=1; the surviving mass gives (1-e^{-2mu})/2=.316 at mu=.5.",
      "predictions": [
        {
          "id": "P1",
          "metric": "p_sparse",
          "direction": "lower",
          "minimum_effect": ".316+-.015",
          "provenance": {
            "written_at": "2026-10-31",
            "data_seen": [],
            "sample_status": "out_of_sample"
          },
          "role": "decisive"
        },
        {
