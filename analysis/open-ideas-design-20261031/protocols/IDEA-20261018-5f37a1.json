  "question": "On the frozen N19 pool of 66045 four-orbit bases, is the score sd 0.8-1.25 times the exact occupancy-null sd, and are the pool and plane winners within 1 sd of the selection-matched expected maximum?",
  "claims": [
    {
      "id": "C1",
      "text": "Stage 0 reads base_scores.json of RUN-KIC-234d11 and computes mean, sd, skew, max, min and the exact occupancy null under both counting conventions.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "The log-blind pool reaches at most 0.1 of the log-aware headroom while the log-aware greedy control sits at least 5 null sd above the mean.",
      "class": "comparative",
      "decided_by": [
        "C-null"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "Coverage gained without discrete logarithms is an order statistic of the exact orbit-class occupancy null and carries no exploitable structure.",
      "mechanism": "M_c m-sum classes thrown into N_c target classes give occupancy variance about N_c e^-lam(1-(1+lam)e^-lam); a log-blind pool search reaches mean + z(K_eff) sd, whereas the log-aware headroom min(1,lam) needs logs.",
      "predictions": [
        {
          "id": "P1",
          "metric": "sd_ratio",
          "direction": "different",
          "minimum_effect": "0.8 to 1.25",
          "provenance": {
            "written_at": "2026-10-31",
            "data_seen": [],
            "sample_status": "out_of_sample"
          },
          "role": "decisive"
        },
        {
          "id": "P2",
          "metric": "winner_z",
          "direction": "lower",
          "minimum_effect": "|z|<=1",
          "provenance": {
            "written_at": "2026-10-31",
            "data_seen": [],
            "sample_status": "out_of_sample"
          },
          "role": "decisive"
        },
        {
