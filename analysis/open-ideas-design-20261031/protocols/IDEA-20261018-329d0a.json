  "question": "At n=23 and n=29, does B_d have coverage within 2 sd of the orbit-class null and a random stable union, with an O(n)-byte stable description at no more than 2x a random orbit seed's construction cost?",
  "claims": [
    {
      "id": "C1",
      "text": "The census (n<=200) is checked by multiplication and primality; S_d is generated by powers of a generator at one multiplication per element.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "B_d coverage matches the orbit-class null within 2 sd and construction cost stays within 2x a random orbit seed, so the multiplicative lane is a usable stable base.",
      "class": "comparative",
      "decided_by": [
        "C-null"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "Multiplicative-subgroup bases are a Frobenius-stable base lane at prime degrees where the stable-subspace lane is empty, with no coverage bias.",
      "mechanism": "S_d is closed under squaring and, for b=1, under x->1/x; every non-identity orbit of <2,-1> on Z/d has size 2n, so the base has an O(1) description (n, modulus, d) and one exponentiation test.",
      "predictions": [
        {
          "id": "P1",
          "metric": "coverage_z",
          "direction": "different",
          "minimum_effect": "|z|<=2",
          "provenance": {
            "written_at": "2026-10-31",
            "data_seen": [],
            "sample_status": "out_of_sample"
          },
          "role": "decisive"
        },
