  "question": "At n<=23, does every found relation lie in (delta), and is the exact N_w within a factor 3 of the random-lattice count at every cell and weight w<=8?",
  "claims": [
    {
      "id": "C1",
      "text": "N_w (w<=8) is enumerated by meet-in-the-middle and membership in (delta) is checked exactly in Z[tau]; the tau-NAF of delta is a planted positive at its predicted weight.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "The exact N_w is within a factor 3 of the random-lattice count and duplicate class-sums stay within floor+2 sd of the class null.",
      "class": "comparative",
      "decided_by": [
        "C-ideal"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "The relation module of a Koblitz orbit is the principal ideal (delta), and w_min marks where toy tau-stable cells become dimension-forced.",
      "mechanism": "delta=sum_{j<n} tau^j has norm equal to the point-count ratio; Ann(G)=(delta), so every column relation is a multiple of delta and the minimum tau-adic weight controls duplicate class-sums.",
      "predictions": [
        {
          "id": "P1",
          "metric": "nw_ratio",
          "direction": "equal_within",
          "minimum_effect": "factor 3",
