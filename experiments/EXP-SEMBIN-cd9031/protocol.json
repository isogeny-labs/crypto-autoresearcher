  "question": "At fixed |V|=1024 and t=2, does the confinement dispersion factor f_disp track (1+e^{-mu})/2 from mu=.5 down to .0078, while the unconfined arm stays 1.000+-.005?",
  "claims": [
    {
      "id": "C1",
      "text": "c(R) is exact for all targets by one exhaustive pushforward of V^2 into a 2^n count array, and f_disp is scored against the measured mu-hat, not the nominal rate.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "Confined f_disp tracks the closed form within .005 while the unconfined arm is flat at 1, so the 18-22% deficit is a saturation artifact and the clustering reading loses.",
      "class": "comparative",
      "decided_by": [
        "C-form"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "The t=2 yield deficit is trace-parity confinement, and it vanishes as mu drops into the cost-relevant linear regime.",
      "mechanism": "For V in ker Tr the per-target count is a 50/50 mixture of 0 and Poisson(2mu), giving f_disp=(1+e^{-mu})/2; intrinsic clustering would instead be flat at 1/kappa.",
      "predictions": [
        {
          "id": "P1",
          "metric": "f_disp",
          "direction": "higher",
          "minimum_effect": "(1+e^{-mu})/2 within .005",
          "provenance": {
