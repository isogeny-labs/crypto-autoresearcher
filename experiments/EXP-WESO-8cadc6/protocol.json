    {
      "id": "C1",
      "text": "Every explicit (n, eps) pair is extracted from EUROCRYPT 2023 Lemma 14 and the Pizer/[37] citation, labelled by walk type and distance, with the minimum eps recorded.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "No cited n displays eps(n) < 2^-15, so Lemma 3.5's uniform-curve probability is not yet attached to Algorithm 3 at the NIST-I row.",
      "class": "comparative",
      "decided_by": [
        "C-budget"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
