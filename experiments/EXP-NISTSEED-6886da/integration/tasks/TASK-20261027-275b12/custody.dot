digraph custody {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.40", label="TASK-20261027-275b12: additive ECPP custody flow\nEngineering source; guarded synthetic controls; real route deferred", labelloc=t, fontsize=18, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#334155", fontname="Helvetica", fontsize=11, margin="0.12,0.08"];
  edge [color="#475569", fontname="Helvetica", fontsize=9];
  inputs [label="Pinned source + complete ordered 21-row cohort\nExternal binding + exact configuration/argv\nReal runtime/catalogue/kernel or explicit synthetic profile"];
  supervisor [label="Supervisor-owned provenance\nlaunch / environment / command / stdout / stderr\nExactly five files before V9; rehash unchanged afterward", fillcolor="#fef3c7"];
  capture [label="Fresh wrapper-owned capture directory\nDistinct from supervisor tree\nSynchronous Python capture; frozen child capture retained"];
  v9 [label="Frozen V9 run_trial\nWhole-boundary fake in tests\nDeferred admitted real boundary in future packet"];
  raw [label="Retained legacy-child bytes\nIdentity, launch intent, serial, status, body, certificate\nPartial / failed / malformed output retained"];
  recovery [label="Independently identified integration recovery\nOriginal boundary exception + later recovery errors\nNo invented V9 success record"];
  traces [label="Supplemental printed-token trace + evidence counters\nOffsets / digests / source rules / unknown starts\nSynthetic counts separated from real observations"];
  capsule [label="Deterministic raw capsule + exact inventory\nClosed driver logs + every raw regular member\nNo unchecked extraction"];
  envelope [label="Integration envelope\nExact outer sidecar sizes/digests\nOriginal V9 records + bindings + capsule/inventory\nNo recursive self-hash"];
  checker [label="Independent checker\nRehash source / full cohort / configuration / supervisor\nReconstruct live membership, capsule, traces and counters"];
  censored [label="Custody-valid retained observation\nINDETERMINATE; scientific admission false\nMalformed or unavailable status remains explicit", fillcolor="#fef3c7"];
  admitted [label="Complete software component admission\nBoth strict frames + primitive statuses\nRoot/grammar/steps/body + all frozen V9 checks\nSynthetic admission remains separate", fillcolor="#dcfce7"];
  later [label="Later Coordinator packet + independent review\nProtocol, controls, storage, approval, ready state\nHistorical/predictive commonality criterion unchanged", style="rounded,dashed", fillcolor="#f8fafc"];
  inputs -> v9;
  supervisor -> v9 [label="read only"];
  capture -> v9 [label="capture before entry"];
  v9 -> raw;
  v9 -> recovery [label="bounded failure retention"];
  raw -> traces;
  capture -> capsule [label="flush / close / exact copy"];
  raw -> capsule;
  traces -> capsule [label="supplemental trace"];
  capsule -> envelope;
  recovery -> envelope;
  traces -> envelope [label="outer counter sidecar"];
  supervisor -> envelope [label="pre/post identities"];
  envelope -> checker;
  inputs -> checker [label="independent expected identities"];
  checker -> censored [label="integrity holds; admission absent"];
  checker -> admitted [label="all successful-admission gates"];
  admitted -> later [style=dashed,label="engineering input only"];
  censored -> later [style=dashed,label="retained scoped observation"];
}
