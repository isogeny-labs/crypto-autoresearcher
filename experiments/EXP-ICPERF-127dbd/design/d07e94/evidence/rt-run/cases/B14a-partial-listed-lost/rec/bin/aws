#!/usr/bin/env bash
# Delegating wrapper for tests/rt_regression.sh (ported from the 9d2b6a red-team fixture fixtures/isobin-wrap/aws, sha256 bbaf62de63ae62214d7fa015c40d46a60d8e636ee82698dfb7285c5ce2d1a127).
# NOT an aws client: every call is passed unchanged to the committed offline fake tests/fake-aws by absolute path (RT_FAKE_AWS), which
# serves $FAKE_S3_ROOT and refuses S3 writes. After the fake returns, it can simulate three things the fake cannot express:
#   RT_MODE=partial  a recursive download that failed on one object: delete $RT_DROP (if any) from the destination and exit 1;
#   RT_MODE=toctou   a third-party write into the fake bucket right after listing number $RT_TOCTOU_AT of s3://B/runs/<job>/ (`s3 ls`):
#                    run $RT_TOCTOU_HOOK (a script that mutates $FAKE_S3_ROOT only);
#   RT_MODE=toctou2  the same hook right after listing number $RT_TOCTOU_AT of an `s3api list-objects-v2` call on a pod prefix.
# v3c: the scripts run under `env -i`, so the settings come from the conf file in this file's directory (fake-aws.conf, shell syntax);
# the conf sets FAKE_AWS_LOG, FAKE_S3_ROOT, RT_FAKE_AWS, RT_STATE and the RT_* knobs. The wrapper exports FAKE_AWS_CONF for the fake.
conf=$(dirname -- "$0")/fake-aws.conf
[[ -f $conf ]] && . "$conf"
export FAKE_AWS_CONF=$conf FAKE_S3_ROOT FAKE_AWS_LOG   # exported so that the hook script sees them
[[ -n ${FAKE_S3_ROOT:-} && -n ${FAKE_AWS_LOG:-} ]] || { echo "RT-WRAP: no FAKE_S3_ROOT or FAKE_AWS_LOG in $conf" >&2; exit 96; }
"${RT_FAKE_AWS:?}" "$@"; rc=$?
case "${RT_MODE:-}" in
partial)
  if [[ "${1:-} ${2:-}" == "s3 cp" && " $* " == *" --recursive "* && $rc == 0 ]]; then
    [[ -n ${RT_DROP:-} ]] && rm -f -- "${4%/}/$RT_DROP"
    echo "RT-WRAP partial: dropped ${RT_DROP:-nothing} from ${4:-}, returning 1" >> "$FAKE_AWS_LOG"; exit 1
  fi ;;
toctou)
  if [[ "${1:-} ${2:-}" == "s3 ls" && ${3:-} =~ ^s3://[^/]+/runs/[A-Za-z0-9-]+/$ ]]; then
    n=$(( $(cat "$RT_STATE/ls_count" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$RT_STATE/ls_count"
    if [[ $n == "${RT_TOCTOU_AT:-0}" ]]; then echo "RT-WRAP toctou: hook after listing #$n of $3" >> "$FAKE_AWS_LOG"; bash "$RT_TOCTOU_HOOK"; fi
  fi ;;
toctou2)
  if [[ "${1:-} ${2:-}" == "s3api list-objects-v2" && " $* " =~ \ --prefix\ runs/[A-Za-z0-9-]+/[0-9a-f-]{36}/\  ]]; then
    n=$(( $(cat "$RT_STATE/ls2_count" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$RT_STATE/ls2_count"
    if [[ $n == "${RT_TOCTOU_AT:-0}" ]]; then echo "RT-WRAP toctou2: hook after pod listing #$n" >> "$FAKE_AWS_LOG"; bash "$RT_TOCTOU_HOOK"; fi
  fi ;;
esac
exit $rc
