  "question": "Does bounded-PC learning prune before whole-block enumeration and cut charged search cost by 2x against the strongest enumeration/SMT control on held-out cells, with certificates that agree with the exact oracle?",
  "claims": [
    {
      "id": "C1",
      "text": "Every UNSAT verdict carries a checkable certificate and every model is verified by group replay; invalid certificates or omitted finite domains invalidate the arm.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "Charged search cost, all theory calls included, is at most 0.5x the strongest enumeration/SMT control on held-out cells.",
      "class": "comparative",
      "decided_by": [
        "C-gain"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "Bounded-PC learning with certificate-producing finite-domain theory prunes before whole-block enumeration and halves charged search cost.",
      "mechanism": "A learned theory prefix can exclude blocks earlier than enumeration; it pays only if the explanation construction is cheaper than the enumeration it replaces.",
