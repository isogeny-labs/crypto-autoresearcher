  "question": "With Poisson background <=1e-5, does the conditional extra-solution rate nu_t exceed the null at any cell t=4..12, and does the planted 2-torsion flip recover exactly 2^{t-1}-1?",
  "claims": [
    {
      "id": "C1",
      "text": "Extra-solution events are recounted by meet-in-the-middle over canonical multisets for 2e4 sampled targets per cell, so a single event is structure, not noise.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "nu_t stays within the null bound in every cell while the planted flip recovers 2^{t-1}-1, so no intrinsic clustering is detected in the tested box.",
      "class": "comparative",
      "decided_by": [
        "C-null"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
