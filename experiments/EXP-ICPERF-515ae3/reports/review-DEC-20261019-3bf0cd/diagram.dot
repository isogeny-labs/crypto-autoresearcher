digraph checker_gate {
  graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.35", ranksep="0.55", labelloc=t, fontsize=17, fontname="Helvetica", label="TASK-20261019-52baee: independent synthetic tool controls (21 cases)"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#4b5563", fillcolor="#f8fafc", margin="0.15,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#475569"];
  baseline [label="1 frozen baseline\nexternally pinned plan", fillcolor="#e0f2fe"];
  pin [label="External SHA-256 plan\nadmission", fillcolor="#e0f2fe"];
  compose [label="Attestation, verdict\nand blindness checks", fillcolor="#e0f2fe"];
  accepted [label="1 accepted\n(tool gate only)", fillcolor="#dcfce7", color="#15803d"];
  false_plan [label="8 false controls\n2 pin + 6 plan mutations", fillcolor="#fef3c7"];
  false_compose [label="12 false controls\nattestation / verdict / blindness", fillcolor="#fef3c7"];
  rejected_plan [label="8 rejected", fillcolor="#fee2e2", color="#b91c1c"];
  rejected_compose [label="12 rejected", fillcolor="#fee2e2", color="#b91c1c"];
  direct [label="Direct check() on arbitrary plan\nmissing joint key / 1-character text can pass\noutside accepted boundary", style="rounded,dashed", color="#b45309", fillcolor="white"];
  baseline -> pin -> compose -> accepted;
  false_plan -> pin [label="changed plan or pin"];
  pin -> rejected_plan [label="8 refusals"];
  false_compose -> compose [label="false attestations"];
  compose -> rejected_compose [label="12 refusals"];
  direct -> compose [style=dashed, color="#b45309", label="not an admitted route"];
  {rank=same; baseline; false_plan; false_compose; direct}
}
