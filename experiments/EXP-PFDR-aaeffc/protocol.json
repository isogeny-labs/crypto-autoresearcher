  "question": "In the exact prime-field encoding, do exceptional denominator components rather than the genuine decomposition component account for a material part of solving cost, so chart-local saturation is 2x cheaper than the unsaturated exact baseline at identical recovered solution sets?",
  "claims": [
    {
      "id": "C1",
      "text": "The exhaustive small chart census must produce exact chart-union model equality, including generic additions, equal-x, doubling, infinity and norm-denominator-zero cases.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "Chart-local saturation cuts complete chart-union solve cost by 2x against the unsaturated exact baseline with an identical recovered solution set.",
      "class": "comparative",
      "decided_by": [
        "C-gain"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "Exceptional denominator components account for a material share of solving cost, and chart-local saturation removes it without discarding valid relations.",
      "mechanism": "Saturating exceptional factors before the expensive closure removes components that are not the decomposition component; the gain is real only if the recovered solution set is unchanged and the certificate cost does not cancel it.",
      "predictions": [
        {
          "id": "P1",
          "metric": "complete_chart_union_solve_cost",
          "direction": "lower",
          "minimum_effect": "<=0.5x unsaturated baseline",
