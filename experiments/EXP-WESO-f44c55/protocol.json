  "question": "At n=256, does the quoted 2^80 n^4 trial factor multiply the Theorem 5.3 expected-time product, or is it cancelled by a displayed identity?",
  "claims": [
    {
      "id": "C1",
      "text": "Two readers locate the introduction and cancellation of 2^80 from arXiv:2609.22018v1 Theorem 4.4 (p.16), Eq. 55 and the proof of Theorem 5.3 (p.22), and agree on the line and exponent.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "The 2^80 trial factor is present (not cancelled), so the n=256 product is >=2^197 and Heuristic 1 stays load-bearing below 2^128.",
      "class": "comparative",
      "decided_by": [
        "C-present"
      ],
      "if_supported": "the claim holds within the frozen cells and instrument named here",
      "if_not_supported": "the claim is refuted within the frozen cells; report the direction and effect"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "The 2^80 factor in Theorem 4.4 enters the Theorem 5.3 expected-time product at n=256.",
      "mechanism": "2^80 n^4 counts objects examined; substituting n=256 makes the trial factor 2^112, and one p^(1/3) pass multiplies it by about 2^85.",
