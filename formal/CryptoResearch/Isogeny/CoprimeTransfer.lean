/-
Conditional coprime recovery for cyclic-subgroup transfer.

Source: research/THM_K163_COPRIME_TRANSFER1.md
Target: formal/targets/k163-coprime-recovery-transfer-20261031.yaml

WHAT IS PROVED.
If additive homomorphisms `phi` and `recovery` satisfy
`recovery (phi X) = d • X`, then coprimality of `d` and `r` makes `phi`
injective on the `r`-torsion.  Every scalar relation is therefore preserved
and reflected; interpreting it as a discrete logarithm also requires the
target to lie in the cyclic subgroup generated by the base.  The closed K-163 arithmetic
`gcd(45641, r) = 1` is also checked against the existing K-163 constant.

WHAT IS NOT PROVED.
No elliptic curve, isogeny, dual map, exceptional-point rule, field of
definition, endpoint, point order, transfer cost, or ECDLP advantage is
constructed here.  Those are explicit bridge obligations in the source note.
-/
import CryptoResearch.Endosweep.Koblitz
import Mathlib.Data.Int.GCD
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.Module

namespace CryptoResearch.Isogeny.CoprimeTransfer

/-- A recovery composition `[d]` with `gcd(d,r)=1` makes the forward
homomorphism injective on elements killed by `r`.

This is an abstract additive-group theorem.  Interpreting `d` as an isogeny
degree requires a separately certified geometric map and dual. -/
theorem eq_of_map_eq_of_recovery
    {E E' : Type*} [AddCommGroup E] [AddCommGroup E']
    (phi : E →+ E') (recovery : E' →+ E) (d r : ℕ)
    (hcomp : ∀ X, recovery (phi X) = (d : ℤ) • X)
    (hcop : Nat.Coprime d r)
    {P Q : E} (hP : (r : ℤ) • P = 0) (hQ : (r : ℤ) • Q = 0)
    (hmap : phi P = phi Q) : P = Q := by
  let Z := P - Q
  have hphiZ : phi Z = 0 := by
    dsimp [Z]
    rw [map_sub, hmap, sub_self]
  have hdZ : (d : ℤ) • Z = 0 := by
    rw [← hcomp Z, hphiZ, map_zero]
  have hrZ : (r : ℤ) • Z = 0 := by
    dsimp [Z]
    rw [smul_sub, hP, hQ, sub_self]
  have hbez : Nat.gcdA d r * (d : ℤ) + Nat.gcdB d r * (r : ℤ) = 1 := by
    have h := Nat.gcd_eq_gcd_ab d r
    rw [hcop.gcd_eq_one] at h
    simpa [Int.mul_comm] using h.symm
  have hZ : Z = 0 := by
    calc
      Z = (1 : ℤ) • Z := by simp
      _ = (Nat.gcdA d r * (d : ℤ) + Nat.gcdB d r * (r : ℤ)) • Z := by rw [hbez]
      _ = Nat.gcdA d r • ((d : ℤ) • Z) + Nat.gcdB d r • ((r : ℤ) • Z) := by
        rw [add_zsmul, mul_zsmul, mul_zsmul]
      _ = 0 := by rw [hdZ, hrZ]; simp
  exact sub_eq_zero.mp hZ

/-- On the `r`-torsion, the forward homomorphism preserves and reflects every
integer scalar relation. -/
theorem map_eq_zsmul_iff
    {E E' : Type*} [AddCommGroup E] [AddCommGroup E']
    (phi : E →+ E') (recovery : E' →+ E) (d r : ℕ)
    (hcomp : ∀ X, recovery (phi X) = (d : ℤ) • X)
    (hcop : Nat.Coprime d r)
    {P Q : E} (hP : (r : ℤ) • P = 0) (hQ : (r : ℤ) • Q = 0)
    (k : ℤ) : phi Q = k • phi P ↔ Q = k • P := by
  constructor
  · intro h
    apply eq_of_map_eq_of_recovery phi recovery d r hcomp hcop hQ
    · rw [smul_comm]
      simp [hP]
    · simpa using h
  · rintro rfl
    exact map_zsmul phi k P

/-- A coprime recovery composition preserves the exact additive order of an
`r`-torsion point.  This makes the no-collapse consequence explicit without
assuming that `r` is prime. -/
theorem map_addOrderOf_eq_of_recovery
    {E E' : Type*} [AddCommGroup E] [AddCommGroup E']
    (phi : E →+ E') (recovery : E' →+ E) (d r : ℕ)
    (hcomp : ∀ X, recovery (phi X) = (d : ℤ) • X)
    (hcop : Nat.Coprime d r)
    {P : E} (hP : (r : ℤ) • P = 0) :
    addOrderOf (phi P) = addOrderOf P := by
  rw [addOrderOf_eq_addOrderOf_iff]
  intro n
  constructor
  · intro hn
    apply eq_of_map_eq_of_recovery phi recovery d r hcomp hcop
    · calc
        (r : ℤ) • (n • P) = n • ((r : ℤ) • P) := by rw [smul_comm]
        _ = 0 := by rw [hP]; simp
    · simp
    · simpa using hn
  · intro hn
    rw [← map_nsmul, hn, map_zero]

open CryptoResearch.Endosweep.Koblitz

/-! ## Degree-45,641 same-curve horizontal control -/

/-- The split CM element `51 - 160τ` used by the retained K-163 horizontal
control.  This is arithmetic in the formal pair model `Z[τ]`, not a vertical
isogeny construction. -/
def k163HorizontalAlphaCM : Zt := ⟨51, -160⟩

/-- The exact coefficient identity behind the retained horizontal control:
the conjugate of `51 - 160τ` is `-109 + 160τ`, and their product is the
scalar 45,641 in `Z[τ]` with `τ² = τ - 2`. -/
theorem k163_horizontal_cm_factorization :
    Zt.conj 1 k163HorizontalAlphaCM = ⟨-109, 160⟩ ∧
      Zt.mul 1 k163HorizontalAlphaCM (Zt.conj 1 k163HorizontalAlphaCM) =
        ⟨45641, 0⟩ := by
  decide +kernel

/-- Point action of `51 - 160τ` for an abstract additive endomorphism `τ`. -/
def horizontalAlpha {E : Type*} [AddCommGroup E] (tau : E →+ E) : E →+ E :=
  51 • AddMonoidHom.id E - 160 • tau

/-- Point action of the conjugate `-109 + 160τ`. -/
def horizontalRecovery {E : Type*} [AddCommGroup E] (tau : E →+ E) : E →+ E :=
  160 • tau - 109 • AddMonoidHom.id E

/-- If `τ² = τ - 2`, the horizontal recovery composed after the horizontal
forward action is scalar multiplication by 45,641. -/
theorem horizontal_recovery_comp
    {E : Type*} [AddCommGroup E] (tau : E →+ E)
    (htau : ∀ X, tau (tau X) = tau X - (2 : ℤ) • X) :
    ∀ X, horizontalRecovery tau (horizontalAlpha tau X) = (45641 : ℤ) • X := by
  intro X
  change 160 • tau (51 • X - 160 • tau X) - 109 • (51 • X - 160 • tau X) =
    (45641 : ℤ) • X
  rw [map_sub, map_nsmul, map_nsmul, htau]
  module

/-- The opposite horizontal composition is also scalar multiplication by
45,641 under the same quadratic relation. -/
theorem horizontal_forward_comp
    {E : Type*} [AddCommGroup E] (tau : E →+ E)
    (htau : ∀ X, tau (tau X) = tau X - (2 : ℤ) • X) :
    ∀ X, horizontalAlpha tau (horizontalRecovery tau X) = (45641 : ℤ) • X := by
  intro X
  change 51 • (160 • tau X - 109 • X) -
    160 • tau (160 • tau X - 109 • X) = (45641 : ℤ) • X
  rw [map_sub, map_nsmul, map_nsmul, htau]
  module

/-- The standard K-163 subgroup-order constant, reusing the existing formal
certificate constant rather than introducing a second independent literal. -/
abbrev k163SubgroupOrder : ℕ := K163.n.natAbs

/-- The reused K-163 constant has the published decimal value. -/
theorem k163_subgroup_order_value :
    k163SubgroupOrder =
      5846006549323611672814741753598448348329118574063 := by
  decide +kernel

/-- The candidate vertical degree 45,641 is coprime to the standard K-163
subgroup-order constant. -/
theorem k163_degree_coprime : Nat.Coprime 45641 k163SubgroupOrder := by
  decide +kernel

/-- The residue by which `51 - 160τ` would act on the standard K-163
subgroup if the published Frobenius eigenvalue bridge is supplied. -/
def k163HorizontalAlphaScalar : Int := (51 - 160 * K163.lam) % K163.n

/-- The companion residue for `-109 + 160τ`. -/
def k163HorizontalRecoveryScalar : Int := (-109 + 160 * K163.lam) % K163.n

/-- Closed arithmetic matching the two scalar residues in the retained
horizontal-control receipt.  This does not prove `τ(G) = [K163.lam]G`. -/
theorem k163_horizontal_scalar_values :
    k163HorizontalAlphaScalar =
      4305110247233098359902032639579138367335695064214 ∧
    k163HorizontalRecoveryScalar =
      1540896302090513312912709114019309980993423509791 := by
  decide +kernel

/-- The two archived scalar residues multiply to 45,641 modulo the reused
K-163 subgroup-order constant. -/
theorem k163_horizontal_scalar_product :
    (k163HorizontalAlphaScalar * k163HorizontalRecoveryScalar) % K163.n =
      45641 := by
  decide +kernel

/-- Neither horizontal scalar residue collapses the selected subgroup-order
constant. -/
theorem k163_horizontal_scalars_coprime :
    Nat.Coprime k163HorizontalAlphaScalar.natAbs K163.n.natAbs ∧
      Nat.Coprime k163HorizontalRecoveryScalar.natAbs K163.n.natAbs := by
  decide +kernel

/-- Under the supplied recovery composition, the forward image of an exact
order-`r` K-163 generator still has exact order `r`. -/
theorem k163_map_preserves_generator_order
    {E E' : Type*} [AddCommGroup E] [AddCommGroup E']
    (phi : E →+ E') (recovery : E' →+ E)
    (hcomp : ∀ X, recovery (phi X) = (45641 : ℤ) • X)
    {P : E}
    (hPorder : addOrderOf P = k163SubgroupOrder) :
    addOrderOf (phi P) = k163SubgroupOrder := by
  have hP : (k163SubgroupOrder : ℤ) • P = 0 := by
    have hn : k163SubgroupOrder • P = 0 := by
      rw [← hPorder]
      exact addOrderOf_nsmul_eq_zero P
    simpa using hn
  rw [map_addOrderOf_eq_of_recovery phi recovery 45641 k163SubgroupOrder hcomp
    k163_degree_coprime hP, hPorder]

/-- The explicit horizontal action preserves the exact generator order once
`τ` satisfies its Koblitz quadratic relation.  Unlike the vertical theorem,
this result derives the recovery composition rather than assuming it. -/
theorem k163_horizontal_control_preserves_generator_order
    {E : Type*} [AddCommGroup E]
    (tau : E →+ E)
    (htau : ∀ X, tau (tau X) = tau X - (2 : ℤ) • X)
    {P : E}
    (hPorder : addOrderOf P = k163SubgroupOrder) :
    addOrderOf (horizontalAlpha tau P) = k163SubgroupOrder :=
  k163_map_preserves_generator_order (horizontalAlpha tau) (horizontalRecovery tau)
    (horizontal_recovery_comp tau htau) hPorder

/-- The explicit 45,641-composition horizontal K-163 control preserves and reflects
every scalar relation on the `r`-torsion.  The theorem remains abstract: it
does not identify `tau` with Frobenius on a concrete elliptic curve. -/
theorem k163_horizontal_control_preserves_scalar_relations
    {E : Type*} [AddCommGroup E]
    (tau : E →+ E)
    (htau : ∀ X, tau (tau X) = tau X - (2 : ℤ) • X)
    {P Q : E}
    (hPorder : addOrderOf P = k163SubgroupOrder)
    (hQ : (k163SubgroupOrder : ℤ) • Q = 0)
    (k : ℤ) :
    horizontalAlpha tau Q = k • horizontalAlpha tau P ↔ Q = k • P := by
  have hP : (k163SubgroupOrder : ℤ) • P = 0 := by
    have hn : k163SubgroupOrder • P = 0 := by
      rw [← hPorder]
      exact addOrderOf_nsmul_eq_zero P
    simpa using hn
  exact map_eq_zsmul_iff (horizontalAlpha tau) (horizontalRecovery tau)
    45641 k163SubgroupOrder (horizontal_recovery_comp tau htau)
    k163_degree_coprime hP hQ k

/-- **K-163 conditional transfer gate.**

If supplied additive homomorphisms satisfy the degree-45,641 recovery
composition, then they preserve and reflect the scalar relation for an exact
order-`r` K-163 generator and any selected `r`-torsion target.  This theorem
does not supply the homomorphisms or connect them to a geometric isogeny. -/
theorem k163_transfer_preserves_scalar_relations
    {E E' : Type*} [AddCommGroup E] [AddCommGroup E']
    (phi : E →+ E') (recovery : E' →+ E)
    (hcomp : ∀ X, recovery (phi X) = (45641 : ℤ) • X)
    {P Q : E}
    (hPorder : addOrderOf P = k163SubgroupOrder)
    (hQ : (k163SubgroupOrder : ℤ) • Q = 0)
    (k : ℤ) : phi Q = k • phi P ↔ Q = k • P := by
  have hP : (k163SubgroupOrder : ℤ) • P = 0 := by
    have hn : k163SubgroupOrder • P = 0 := by
      rw [← hPorder]
      exact addOrderOf_nsmul_eq_zero P
    simpa using hn
  exact map_eq_zsmul_iff phi recovery 45641 k163SubgroupOrder hcomp
    k163_degree_coprime hP hQ k

/-! ## Proves-too-much control -/

/-- Multiplication by two on `ZMod 6` is the noncoprime control map. -/
def noncoprimeDouble : ZMod 6 →+ ZMod 6 :=
  (2 : ℕ) • AddMonoidHom.id (ZMod 6)

/-- The noncoprime control has a `[2]` recovery composition but is not
injective: it maps both `0` and `3` to `0`.  Thus coprimality cannot be dropped
from the transfer theorem. -/
theorem noncoprime_recovery_control :
    (∀ x, (AddMonoidHom.id (ZMod 6)) (noncoprimeDouble x) = (2 : ℤ) • x) ∧
      ¬Function.Injective noncoprimeDouble := by
  have hcollision :
      (2 : ℕ) • (0 : ZMod 6) = (2 : ℕ) • (3 : ZMod 6) ∧
        (0 : ZMod 6) ≠ (3 : ZMod 6) := by
    decide +kernel
  constructor
  · intro x
    rfl
  · intro hinj
    exact hcollision.2 (hinj hcollision.1)

end CryptoResearch.Isogeny.CoprimeTransfer
